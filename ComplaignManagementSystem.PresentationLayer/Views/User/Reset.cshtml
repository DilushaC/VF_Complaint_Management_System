@model ComplaignManagementSystem.Data.Context.DapperContext


@{
    ViewData["Title"] = "Password Reset";
    Layout = null;
}


<html class="loading" lang="en" data-textdirection="ltr">
<!-- BEGIN: Head-->
<!-- Mirrored from themeselection.com/demo/chameleon-admin-template/html/ltr/vertical-menu-template/login.html by HTTrack Website Copier/3.x [XR&CO'2014], Mon, 30 Nov 2020 04:59:17 GMT -->
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta name="description" content="Chameleon Admin is a modern Bootstrap 4 webapp &amp; admin dashboard html template with a large number of components, elegant design, clean and organized code.">
    <meta name="keywords" content="admin template, Chameleon admin template, dashboard template, gradient admin template, responsive admin template, webapp, eCommerce dashboard, analytic dashboard">
    <meta name="author" content="ThemeSelect">
    <title>Reset</title>
    <link rel="apple-touch-icon" href="~/plugins/demo/chameleon-admin-template/app-assets/images/ico/apple-icon-120.png">

    <link rel="shortcut icon" type="image/x-icon" href="~/vallibel-logo.ico" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/vendors.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/toggle/switchery.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/plugins/forms/switch.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/bootstrap-extended.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/colors.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/components.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/core/menu/menu-types/vertical-menu.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/core/colors/palette-gradient.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/css/pages/login-register.min.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/assets/css/style.css" rel="stylesheet" />
    <link href="~/plugins/demo/chameleon-admin-template/app-assets/fonts/line-awesome/css/line-awesome.min.css" rel="stylesheet" />

    <link href="~/plugins/demo/chameleon-admin-template/app-assets/fonts/feather/style.min.css" rel="stylesheet" />
</head>
<!-- END: Head-->
<!-- BEGIN: Body-->
<body class="vertical-layout vertical-menu 1-column  bg-full-screen-image blank-page blank-page" data-open="click" data-menu="vertical-menu" data-color="bg-gradient-x-purple-blue" data-col="1-column">
    <!-- BEGIN: Content-->
    <div class="app-content content">
        <div class="content-wrapper">
            <div class="content-wrapper-before"></div>
            <div class="content-header row">
            </div>
            <div class="content-body">
                <section class="flexbox-container">
                    <div class="col-12 d-flex align-items-center justify-content-center">
                        <div class="col-lg-4 col-md-6 col-10 box-shadow-2 p-0">
                            <div class="card border-grey border-lighten-3 px-1 py-1 m-0">
                                <div class="card-header border-0">
                                    <div class="text-center mb-1">
                                        <img src="~/plugins/demo/chameleon-admin-template/app-assets/images/logo/logo.png" alt="branding logo" />
                                    </div>
                                    <div class="font-large-1  text-center">
                                        Reset Your Password
                                    </div>
                                </div>
                                <div class="card-content">
                                    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "ResetForm" }))
                                    {
                                        <div class="card-body">
                                            <fieldset class="form-group position-relative has-icon-left">
                                                <input name="NewPassword" id="NewPassword" type="password" class="form-control round" placeholder="Enter New Password" autocomplete="off" required />
                                                <div class="form-control-position" style="margin-top:13px">
                                                    <i class="ft-lock"></i>
                                                </div>
                                            </fieldset>

                                            <fieldset class="form-group position-relative has-icon-left">
                                                <input name="ConPassword" id="ConPassword" type="password" class="form-control round" autocomplete="off" placeholder="Enter Confirm Password" required />
                                                <div class="form-control-position" style="margin-top:13px">
                                                    <i class="ft-lock"></i>
                                                </div>
                                            </fieldset>
                                            <span id="error-message"></span>
                                            <div class="form-group text-center">
                                                <button type="button" id="ResetId" class="btn round btn-block btn-glow btn-bg-gradient-x-purple-blue col-12 mr-1 mb-1">
                                                    Reset
                                                </button>
                                            </div>
                                        </div>
                                    }
                                
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </div>
    </div>

    <script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/vendors.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/forms/toggle/switchery.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/forms/switch.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/forms/validation/jqbootstrapvalidation.js"></script>

    <script src="~/plugins/demo/chameleon-admin-template/app-assets/js/core/app-menu.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/js/core/app.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/forms/form-login-register.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/customizer.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/jquery.sharrre.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/sweet alert/sweetalert2.all.min.js"></script>

    <script type="text/javascript">

        $("#Error").hide();            
        $('#ResetId').on('click', function (e) {
            e.preventDefault();

            var data = {
                NewPassword: $('#NewPassword').val(),
                ConPassword: $('#ConPassword').val()
            };
            $.ajax({
                url: '/User/ResetPassword',
                type: 'POST',
                data: data,
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'Successfully Reset!',
                            text: 'Please Login Using new Password.',
                            icon: 'info',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = response.redirectUrl;
                        });
                    } else{
                        $("#Error").text("Invalid username or password!").show();
                    }
                },
                error: function () {
                    $('#error-message').text('An error occurred. Please try again.');
                    $('#success-message').text('');
                }
            });
        });
    </script>
</body>

</html>


