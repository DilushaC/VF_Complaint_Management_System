@model ComplaignManagementSystem.Data.Context.DapperContext

@{
    ViewData["Title"] = "User Creation Form";
    ViewData["MenuTab"] = "UserMainMenu";
    ViewData["SecMenuTab"] = "UserMenu";
    ViewData["SubMenuTab"] = "UserCreation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/css/plugins/forms/checkboxes-radios.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/icheck.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/custom.css" rel="stylesheet" />

<div class="row">
    <div class="col-md-12">
        <div class="card" style="margin-top:15px">
            <div class="card-content collapse show">
                <div class="card-body">
                    @using (Html.BeginForm("CreateUser", "User", FormMethod.Post, new { id = "UserCreationForm" }))
                    {
                        <div class="form-body">
                            <h4 class="form-section">
                                <i class="ft-flag"></i> User Creation Form
                            </h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="UserName">User Name</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <input type="text" id="UserName" class="form-control" placeholder="User Name" name="UserName" autocomplete="off" onkeyup="CheckUserName()">
                                        <small id="error-message-Uname" style="color:red"></small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Name">Name</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <input type="text" id="Name" class="form-control" placeholder="First Name with Last Name" name="Name" autocomplete="off">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Email">User Email</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <input type="text" id="Email" class="form-control" placeholder="User Email" name="Email" autocomplete="off" onkeyup="emailChange()">
                                        <small id="emailError" style="color:red; display:none;">Invalid Email</small>
                                        <small id="error-message-Email" style="color:red"></small>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="BranchId">Branch</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <select id="BranchId" name="BranchId" class="form-control" asp-items="ViewBag.BranchId">
                                            <option value="">-- Select --</option>
                                        </select>
                                        <small id="error-message-Branch" style="color:red"></small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Dep_Id">Department</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <select id="Dep_Id" name="Dep_Id" class="form-control" asp-items="ViewBag.Dep_Id">
                                            <option value="">-- Select --</option>
                                        </select>
                                        <small id="error-message-Dep" style="color:red"></small>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Password">Password</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <input type="password" id="Password" class="form-control" placeholder="Password..." name="Password" autocomplete="off" required>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <br />
                        <div class="form-actions">
                            <button type="button" class="btn btn-danger mr-1">
                                Clear
                            </button>
                            <button type="submit" class="btn btn-success" id="save">
                                Save
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/tables/jquery.datatables.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/modal/components-modal.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/js/font-awesome-all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweet-alerts.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/sweet alert/sweetalert2.all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/select2/js/select2.min.js"></script>
<script>
    $("#BranchId").select2({
      allowClear:true,
      placeholder: 'Select Branch'
    });
    $("#Dep_Id").select2({
      allowClear:true,
      placeholder: 'Select Department'
    });
    function CheckUserName() {
        var UserName = document.getElementById("UserName");
        const errorMessageUnameContainer = document.getElementById('error-message-Uname');
        errorMessageUnameContainer.textContent = '';
             // alert(TrainingCourse_Sequance.value + TrainingCourse_TrainingId);
        const savebtn = document.getElementById("save");
        if(UserName.value != ""){
            $.ajax({
                url: '@Url.Action("CheckUserName", "User")',
                type: 'GET', // or POST
                data: {
                    username: UserName.value
                },
                success: function (response) {
                    if (response.status === true) {
                        errorMessageUnameContainer.textContent = '';
                        errorMessageUnameContainer.style.borderColor = "green";
                        savebtn.disabled = false;
                        console.log("User Name OK");
                    } else {
                        if(response.activestatus === true){                                                   
                            errorMessageUnameContainer.textContent = 'User Name already exists.';                      
                            errorMessageUnameContainer.style.color = 'red';
                            errorMessageUnameContainer.style.borderColor = 'red';
                            savebtn.disabled = true;
                        }else{                                                        
                            errorMessageUnameContainer.textContent = 'User Name already exists but you have to active this user.';
                            errorMessageUnameContainer.style.color = 'red';
                            errorMessageUnameContainer.style.borderColor = 'red';
                            savebtn.disabled = true;
                        }


                        // console.log("Sequence already exists");
                        // errorMessageSeqContainer.textContent = 'Sequence already exists!';
                        return;
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Error occurred: " + error);
                }
            });
        }

    }
    function emailChange() {
        const email = document.getElementById("Email").value.trim();
        const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;          
        const save = document.getElementById("save");
        const emailError = document.getElementById("emailError");
        if (email === "") {
            // Empty field → reset border and hide error
            document.getElementById("Email").style.borderColor = "";
            emailError.style.display = "none";
            save.disabled = true;
            return;
        }

        if (emailPattern.test(email)) {
            // ✅ Valid email
            document.getElementById("Email").style.borderColor = "green";
            emailError.style.display = "none";
            save.disabled = false;
        } else {
            // ❌ Invalid email
            document.getElementById("Email").style.borderColor = "red";
            emailError.style.display = "inline";
            save.disabled = true;
        }
    }
    document.getElementById("save").addEventListener("click", function (event) {          
        let isValid = true;
        var form = $('#UserCreationForm');
        // Clear previous errors        
        document.querySelectorAll("input, select").forEach(el => el.style.borderColor = "");        
        document.querySelectorAll("span[id^='error-message']").forEach(span => span.innerText = "");        
        // --- Required Fields ---        
        const userName = document.getElementById("UserName");        
        const name = document.getElementById("Name");        
        const email = document.getElementById("Email");        
        const branch = document.getElementById("BranchId");        
        const dep = document.getElementById("Dep_Id");        
        const password = document.getElementById("Password");        
        // --- User Name Validation ---        
        if (userName.value.trim() === "") {        
            userName.style.borderColor = "red";        
            document.getElementById("error-message-UserName")?.remove();        
            userName.insertAdjacentHTML('afterend', '<small id="error-message-UserName" style="color:red;">User Name is required</small>');        
            isValid = false;        
        }
        
        // --- Name Validation ---        
        if (name.value.trim() === "") {        
            name.style.borderColor = "red";        
            document.getElementById("error-message-Name")?.remove();        
            name.insertAdjacentHTML('afterend', '<small id="error-message-Name" style="color:red;">Name is required</small>');        
            isValid = false;        
        }
        
        // --- Email Validation ---        
        if (email.value.trim() === "") {        
            email.style.borderColor = "red";        
            const errorMessageMthodContainer = document.getElementById('error-message-Email');        
            // document.getElementById("error-message-Email").innerText = "Email is required";        
            errorMessageMthodContainer.textContent = "Email is required";        
            isValid = false;        
        } 
        
        // --- Branch Validation ---        
        if (branch.value.trim() === "") {        
            branch.style.borderColor = "red";        
            document.getElementById("error-message-Branch").innerText = "Please select a Branch";        
            isValid = false;        
        } else {        
            document.getElementById("error-message-Branch").innerText = "";        
        }
        
        // --- Department Validation ---        
        if (dep.value.trim() === "") {        
            dep.style.borderColor = "red";        
            document.getElementById("error-message-Dep").innerText = "Please select a Department";        
            isValid = false;        
        } else {        
            document.getElementById("error-message-Dep").innerText = "";        
        }
        
        // --- Password Validation ---   
        if (password.value.trim() === "") {           
            password.style.borderColor = "red";  
            // ✅ Check if the error message already exists 
            let existingError = document.getElementById("error-message-Password");           
            if (!existingError) {  
                password.insertAdjacentHTML('afterend', '<small id="error-message-Password" style="color:red;">Password is required</small>');           
            }            
            isValid = false;            
        } else {          
            password.style.borderColor = "";            
            // ✅ Remove the message if the field is valid            
            let existingError = document.getElementById("error-message-Password");            
            if (existingError) {           
                existingError.remove();          
            }  
        }
        
        // Prevent form submission if invalid        
        if (!isValid) {        
            event.preventDefault();        
            return false;        
        }else{        
            form.attr('action', '/User/CreateUser');
            form.submit();       
        }
        // If all valid, allow form submission        
        return true;        
    });
</script>