                            <a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#">
                                <i class="ft-menu font-large-1"></i>
                            </a>
                        </li>
                        <li class="nav-item d-none d-md-block">
                            <a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#">
                                <i class="ft-menu"></i>
                            </a>
                        </li>
                        <li class="nav-item d-none d-md-block">
                            <a class="nav-link nav-link-expand" href="#">
                                <i class="ficon ft-maximize"></i>
                            </a>
                        </li>

                    </ul>
                    <li class="dropdown dropdown-user nav-item">
                        <a class="dropdown-toggle nav-link dropdown-user-link" href="#" data-toggle="dropdown">
                            <span class="avatar avatar-online">
                                <img src="~/plugins/demo/chameleon-admin-template/app-assets/images/portrait/small/avatar-s-19.png" />
                            </span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <div class="arrow_box_right">
                                <a class="dropdown-item" href="#">
                                    <span class="avatar avatar-online">
                                        <img src="~/plugins/demo/chameleon-admin-template/app-assets/images/portrait/small/avatar-s-19.png" alt="avatar" />
                                        <span class="user-name text-bold-700 ml-1">@Context.Session.GetString("UserName")</span>
                                    </span>
                                </a>
                                <div class="dropdown-divider">
                                </div>
                                <form asp-controller="User" asp-action="Login" method="get" style="display:inline;">
                                    <button type="submit" class="dropdown-item" style="background:none; border:none; width:100%; text-align:left;">
                                        <i class="ft-power"></i> Logout
                                    </button>
                                </form>

                            </div>
                        </div>
                    </li>
                </div>
            </div>
        </div>
    </nav>
