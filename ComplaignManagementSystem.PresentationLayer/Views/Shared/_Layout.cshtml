    <script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/pages/dashboard-analytics.min.js"></script>
    <script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>
