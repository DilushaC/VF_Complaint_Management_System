            @* <div class="navigation-background" style="background-image: url("/plugins/demo/chameleon-admin-template/app-assets/images/backgrounds/02.jpg");"></div> *@
            @* <div class="navigation-background" style="background-image: url("/plugins/demo/chameleon-admin-template/app-assets/images/backgrounds/02.jpg");"></div> *@
            <div class="navigation-background" style="background-image: url('@Url.Content("~/plugins/demo/chameleon-admin-template/app-assets/images/backgrounds/02.jpg")');"></div>
            @* <div class="navigation-background" style="background-image: url('/plugins/demo/chameleon-admin-template/app-assets/images/backgrounds/02.jpg');"></div> *@

            @* <div class="navigation-background" style="background-image: url("~/plugins/demo/chameleon-admin-template/app-assets/images/backgrounds/02.jpg");"></div> *@
            <div class="main-menu-content ps ps--active-y" style="height: 704px;">

                <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">

                    <li class="nav-item @(activeMenuTab == "Dashboard" ? "open" : "")"><a href="/ComplaintManageProcess/Dashboard"><i class="ft-home"></i><span class="menu-title" data-i18n="">Dashboard</span></a>
                    <li class="nav-item has-sub @(activeMenuTab == "ComplaintMenu" ? "open" : "")">
                        <a href="#"><i class="ft-file-text"></i>Create Form</a>
                        <ul class="menu-content">
                            <li class="@(activeSubMenuTab == "CreateFormScreen" ? "active" : "")">
                                <a class="menu-item" href="/ComplaintManageProcess/Create">Create Complaint</a>
                            </li>
                            <li class="@(activeSubMenuTab == "ComplaintMaster" ? "active" : "")">
                                <a class="menu-item" href="/ComplaintManageProcess/Index">Complaint Master</a>
                            </li>
                        </ul>
                    </li>

                </ul>

            </div>

        </div>

    </div>
    <div class="border-top footer text-muted bottom">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
