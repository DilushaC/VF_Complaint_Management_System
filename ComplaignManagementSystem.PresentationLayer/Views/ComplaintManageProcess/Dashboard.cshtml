
@{
    ViewData["Title"] = "Dashboard";
    ViewData["MenuTab"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 style="margin-top:20px">Dashboard</h1>

<div class="row">
    <div class="col-md-12 col-lg-8">
        <div class="card">
            <div class="card-header p-1">
                <h4 class="card-title float-left">Complaint progress - 
                    @* <span class="blue-grey lighten-2 font-small-3 mb-0">24 DEC 2017 - 09 Oct 2025</span> *@
                    <span class="blue-grey lighten-2 font-small-3 mb-0" id="dateRange">
                        01 JAN 2025 -
                    </span>
                    </h4>
                <span class="badge badge-pill badge-info float-right m-0">Approved</span>
            </div>
            <div class="card-content collapse show">
                <div class="card-footer text-center p-1">
                    <div class="row">
                        <div class="col-md-3 col-12 border-right-blue-grey border-right-lighten-5 text-center">
                            <p class="blue-grey lighten-2 mb-0">Total</p>
                            <p class="font-medium-5 text-bold-400" id="TotalCountLbl">00</p>
                        </div>
                        <div class="col-md-3 col-12 border-right-blue-grey border-right-lighten-5 text-center">
                            <p class="blue-grey lighten-2 mb-0">Completed</p>
                            <p class="font-medium-5 text-bold-400" id="ResolvedCountLbl">00</p>
                        </div>
                        <div class="col-md-3 col-12 border-right-blue-grey border-right-lighten-5 text-center">
                            <p class="blue-grey lighten-2 mb-0">Pending</p>
                            <p class="font-medium-5 text-bold-400" id="PendingCountLbl">00</p>
                        </div>
                        <div class="col-md-3 col-12 text-center">
                            <p class="blue-grey lighten-2 mb-0">Version</p>
                            <p class="font-medium-5 text-bold-400">1.0v</p>
                        </div>
                    </div>                                    
                </div>
            </div>
        </div>

        @* --------------------------------------- *@

        <div class="card" style="height: 368.25px;">
            <div class="card-content">
                <div id="product-summary" class="media-list position-relative">
                    <div class="table-responsive">
                        <table class="table table-padded table-xl mb-0" id="product-summary-table">
                            <thead>
                                <tr>
                                    <th class="border-top-0">Type</th>                                    
                                    <th class="border-top-0">Count</th>
                                    <th class="border-top-0">Percentage </th>
                                    <th class="border-top-0">Level</th>
                                </tr>
                            </thead>
                            <tbody id="ComplaintMethodTbody">                                                
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="col-md-12 col-lg-4">   
            <div class="col-12">
                <div class="card pull-up bg-gradient-directional-danger">
                    <div class="card-header bg-hexagons-danger">
                        <h4 class="card-title white">Analytics</h4>
                        <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                        <div class="heading-elements">
                            <ul class="list-inline mb-0">
                                <li>
                                    <a class="btn btn-sm btn-white danger box-shadow-1 round btn-min-width pull-right" href="#" target="_blank">Report <i class="ft-bar-chart pl-1"></i></a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-content collapse show bg-hexagons-danger">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center width-100">
                                    <div id="Analytics-donut-chart" class="height-100 donutShadow"><svg xmlns:ct="http://gionkunz.github.com/chartist-js/ct" width="100%" height="100%" class="ct-chart-donut" style="width: 100%; height: 100%;"><g class="ct-series ct-series-a"><path d="M50.002,5A45.01,45.01,0,1,0,50.01,5L50.01,10A40.01,40.01,0,1,1,50.003,10Z" class="ct-slice-donut-solid" ct:value="100"></path></g><g><text dx="50.0098876953125" dy="54.759857177734375" text-anchor="middle" class="ct-label" font-family="feather"></text></g><defs><linearGradient id="donutGradient1" x1="0" y1="1" x2="0" y2="0"><stop offset="0%" stop-color="rgba(250,203,205,1)"></stop><stop offset="95%" stop-color="rgba(250,203,205, 0.7)"></stop></linearGradient></defs></svg></div>
                                </div>
                                <div class="media-body text-right mt-1">
                                    <h3 class="font-large-2 white">12,515</h3>
                                    <h6 class="mt-1"><span class="text-muted white">Analytics in the <a href="#" class="darken-2 white">last year.</a></span></h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-12">
                <div class="card pull-up bg-gradient-directional-info">
                    <div class="card-header bg-hexagons-info">
                        <h4 class="card-title white">Analytics</h4>
                        <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                        <div class="heading-elements">
                            <ul class="list-inline mb-0">
                                <li>
                                    <a class="btn btn-sm btn-white info box-shadow-1 round btn-min-width pull-right" href="#" target="_blank">Report <i class="ft-bar-chart pl-1"></i></a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-content collapse show bg-hexagons-info">
                        <div class="card-body">
                            <div class="media d-flex">
                                <div class="align-self-center width-100">
                                    <div id="Analytics-donut-chart" class="height-100 donutShadow"><svg xmlns:ct="http://gionkunz.github.com/chartist-js/ct" width="100%" height="100%" class="ct-chart-donut" style="width: 100%; height: 100%;"><g class="ct-series ct-series-a"><path d="M50.002,5A45.01,45.01,0,1,0,50.01,5L50.01,10A40.01,40.01,0,1,1,50.003,10Z" class="ct-slice-donut-solid" ct:value="100"></path></g><g><text dx="50.0098876953125" dy="54.759857177734375" text-anchor="middle" class="ct-label" font-family="feather"></text></g><defs><linearGradient id="donutGradient1" x1="0" y1="1" x2="0" y2="0"><stop offset="0%" stop-color="rgba(250,203,205,1)"></stop><stop offset="95%" stop-color="rgba(250,203,205, 0.7)"></stop></linearGradient></defs></svg></div>
                                </div>
                                <div class="media-body text-right mt-1">
                                    <h3 class="font-large-2 white">12,515</h3>
                                    <h6 class="mt-1"><span class="text-muted white">Analytics in the <a href="#" class="darken-2 white">last year.</a></span></h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </div>
</div>





<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">
    
    $(document).ready(function() {
               
        DashboardComplaintCount();
    
        function DashboardComplaintCount() {               
            $.ajax({    
                url: '@Url.Action("DashboardComplaintCount", "ComplaintManageProcess")',    
                type: "GET",    
                data: { },    
                dataType: 'json',    
                success: function (result) {   
                       
                    var totalCount = result.total;
                    var colors = ["danger", "info", "success", "warning"];

                    result.methods.forEach(function(m,index) {
                    var percentage = ((m.complaintCount / totalCount) * 100).toFixed(2);
                    var color = colors[index % colors.length];
                    

                    var row = `
                        <tr>
                            <td>
                                <button class="btn btn-sm btn-outline-${color} round" type="button">${m.method}</button>
                            </td>
                            <td class="text-truncate">${m.complaintCount}</td>
                            <td class="text-truncate">
                                <span><i class="ft-arrow-up success"></i> ${percentage}%</span>
                            </td>
                            <td>
                                <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                                    <div class="progress-bar bg-gradient-x-${color}"
                                         role="progressbar"
                                         style="width: ${percentage}%"
                                         aria-valuenow="${percentage}"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </td>
                        </tr>
                    `;

                    $("#ComplaintMethodTbody").append(row);

                    });

                    $("#TotalCountLbl").text(result.total);    
                    $("#PendingCountLbl").text(result.pending);    
                    $("#ResolvedCountLbl").text(result.resolved);
    
                    var daterange = new Date(result.fromCreatedDate).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase()
                    + " - " +
                    new Date(result.toCreatedDate).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase();
                        
                    $("#dateRange").text(daterange);    
                },error: function (xhr, status, error) {    
                    console.error("Failed to load modal content:", error);    
                    alert("Error");                                          
                }    
            });    
        }






    
    });



        




</script>


