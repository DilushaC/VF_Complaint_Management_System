
@{
    ViewData["Title"] = "Dashboard";
    ViewData["MenuTab"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 style="margin-top:20px"></h1>

<div class="row">
    <div class="col-md-12 col-lg-6">
        <div class="card">
            <div class="card-header p-1">
                <h4 class="card-title float-left">Complaint progress - 
                    @* <span class="blue-grey lighten-2 font-small-3 mb-0">24 DEC 2017 - 09 Oct 2025</span> *@
                    <span class="blue-grey lighten-2 font-small-3 mb-0" id="dateRange">
                        01 JAN 2025 -
                    </span>
                    </h4>
                <span class="badge badge-pill badge-info float-right m-0">Approved</span>
            </div>
            <div class="card-content collapse show">
                <div class="card-footer text-center p-1">
                    <div class="row">
                        <div class="col-md-3 col-12 border-right-blue-grey border-right-lighten-5 text-center">
                            <p class="blue-grey lighten-2 mb-0">Total</p>
                            <p class="font-medium-5 text-bold-400" id="TotalCountLbl">00</p>
                        </div>
                        <div class="col-md-3 col-12 border-right-blue-grey border-right-lighten-5 text-center">
                            <p class="blue-grey lighten-2 mb-0">Completed</p>
                            <p class="font-medium-5 text-bold-400" id="ResolvedCountLbl">00</p>
                        </div>
                        <div class="col-md-3 col-12 border-right-blue-grey border-right-lighten-5 text-center">
                            <p class="blue-grey lighten-2 mb-0">Pending</p>
                            <p class="font-medium-5 text-bold-400" id="PendingCountLbl">00</p>
                        </div>
                        <div class="col-md-3 col-12 text-center">
                            <p class="blue-grey lighten-2 mb-0">Version</p>
                            <p class="font-medium-5 text-bold-400">1.0v</p>
                        </div>
                    </div>                                    
                </div>
            </div>
        </div>

        @* --------------------------------------- *@

        <div class="card" style="height: 55%;">
            <div class="card-content">
                <div id="product-summary" class="media-list position-relative">
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-padded table-xl mb-0" id="product-summary-table" style="border-collapse: collapse; border-spacing: 0 !important; width:100%;">
                            <thead>
                                <tr>
                                    <th class="border-top-0">Type</th>                                    
                                    <th class="border-top-0">Count</th>
                                    <th class="border-top-0">Percentage </th>
                                    <th class="border-top-0">Level</th>
                                </tr>
                            </thead>
                            <tbody id="ComplaintMethodTbody">                                                
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="col-md-12 col-lg-6">

        <div class="card">
            <div class="card-header p-1">
                <h4 class="card-title float-left">
                    Complaints by Department 
                </h4>
                <br>
                <hr>
            </div>
           <div class="container-fluid">
        <div class="card shadow rounded-4 full-height">
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="complaintChart"></canvas>
                </div>
            </div>
        </div>
    </div>
        </div>
            
    </div>
</div>





