<script type="text/javascript">
    
    $(document).ready(function() {
               
        DashboardComplaintCount();
    
        function DashboardComplaintCount() {               
            $.ajax({    
                url: '@Url.Action("DashboardComplaintCount", "ComplaintManageProcess")',    
                type: "GET",    
                data: { },    
                dataType: 'json',    
                success: function (result) {   
                       
                    var totalCount = result.total;
                    var colors = ["danger", "info", "success", "warning"];

                    result.methods.forEach(function(m,index) {
                    var percentage = ((m.complaintCount / totalCount) * 100).toFixed(2);
                    var color = colors[index % colors.length];
                    

                    var row = `
                        <tr >
                            <td>
                                <button class="btn btn-sm btn-outline-${color} round" type="button">${m.method}</button>
                            </td>
                            <td class="text-truncate">${m.complaintCount}</td>
                            <td class="text-truncate">
                                <span><i class="ft-arrow-up success"></i> ${percentage}%</span>
                            </td>
                            <td>
                                <div class="progress progress-sm mt-1 mb-0 box-shadow-2">
                                    <div class="progress-bar bg-gradient-x-${color}"
                                         role="progressbar"
                                         style="width: ${percentage}%"
                                         aria-valuenow="${percentage}"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </td>
                        </tr>
                    `;

                    $("#ComplaintMethodTbody").append(row);

                    });

                    $("#TotalCountLbl").text(result.total);    
                    $("#PendingCountLbl").text(result.pending);    
                    $("#ResolvedCountLbl").text(result.resolved);
    
                    var daterange = new Date(result.fromCreatedDate).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase()
                    + " - " +
                    new Date(result.toCreatedDate).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase();
                        
                    $("#dateRange").text(daterange);  
                    
                    // ==============================
                    // Update Bar Chart dynamically
                    // ==============================
                    let complaintChart;

                    const labels = [];
                    const data = [];
                    const bgColors = [];
                        
                    const colors1 = [
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(255, 99, 132, 0.8)',
                        'rgba(255, 206, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)',
                        'rgba(153, 102, 255, 0.8)'
                    ];
            
                    console.log(result);
                    result.department.forEach(function(dep, index){

                        let Depname = dep.department;
                        if(Depname === 'Information Technology') Depname = 'IT';

                        labels.push(Depname);               // department name
                        data.push(dep.complaintCount);       // count
                        // bgColors.push(`rgba(${50 + index*30}, ${100 + index*20}, ${150 + index*10}, 0.8)`); // dynamic colors
                        bgColors.push(colors1[index % colors1.length]);
                    });
            
                    const ctx = document.getElementById('complaintChart').getContext('2d');
            
                    if (complaintChart) {
                        // If chart already exists, update it
                        complaintChart.data.labels = labels;
                        complaintChart.data.datasets[0].data = data;
                        complaintChart.data.datasets[0].backgroundColor = bgColors;
                        complaintChart.update();
                    } else {
                        // Create chart first time
                        complaintChart = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Complaints Count',
                                    data: data,
                                    backgroundColor: bgColors,
                                    borderRadius: 10
                                }]
                            },
                            options: {
                                responsive: true,
                                animation: {
                                    duration: 1500,
                                    easing: 'easeOutBounce'
                                },
                                plugins: {
                                    legend: { display: false },
                                    title: {
                                        display: true,
                                        text: '',
                                        font: { size: 16 }
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                }
                            }
                        });
                    }

                        },error: function (xhr, status, error) {    
                            console.error("Failed to load modal content:", error);    
                            alert("Error");                                          
                        }    
                    });    
                }






    
    });



        




</script>


