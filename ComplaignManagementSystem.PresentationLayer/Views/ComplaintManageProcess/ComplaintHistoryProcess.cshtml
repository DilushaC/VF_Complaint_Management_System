@using ComplaignManagementSystem.Data.Models
@* @model IEnumerable<ComplaignManagementSystem.Data.Context.DapperContext> *@

@{
    ViewData["Title"] = "Complaint History";
    ViewData["MenuTab"] = "ComplaintHistoryProcessMenu";
    ViewData["SubMenuTab"] = "ComplaintHistoryProcessMenu";
    Layout = "~/Views/Shared/_Layout.cshtml";



}

<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/tables/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/extensions/toastr.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/css/fontawesome-all.min.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #e0f7fa, #fce4ec);
        font-family: 'Poppins', sans-serif;
    }

    .timeline {
        position: relative;
        padding: 3rem 0;
        margin: 0 auto;
    }

        /* Left-side vertical line */
        .timeline::before {
            content: "";
            position: absolute;
            left: 20px;
            top: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(180deg, #4facfe, #00f2fe);
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0, 123, 255, 0.3);
        }

    .timeline-item {
        position: relative;
        width: 100%;
        padding-left: 60px;
        padding-bottom: 2rem;
    }

    .timeline-card {
        position: relative;
        background: #fff;
        border-radius: 15px;
        padding: 1rem 1.5rem;
        width: 50%;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        border-left: 5px solid transparent;
    }

        .timeline-card:hover {
            transform: scale(1.03);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        }

    .timeline-node {
        position: absolute;
        top: 1.5rem;
        left: 10px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        z-index: 2;
        border: 4px solid #fff;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
    }

    /* Colorful gradient steps */
    .timeline-item:nth-child(1) .timeline-card {
        border-left-color: #36d1dc;
        background: linear-gradient(135deg, #36d1dc, #5b86e5);
        color: #fff;
    }

    .timeline-item:nth-child(1) .timeline-node {
        background: #36d1dc;
        box-shadow: 0 0 15px #36d1dc;
    }

    .timeline-item:nth-child(2) .timeline-card {
        border-left-color: #ff9a9e;
        background: linear-gradient(135deg, #ff9a9e, #fad0c4);
        color: #fff;
    }

    .timeline-item:nth-child(2) .timeline-node {
        background: #ff9a9e;
        box-shadow: 0 0 15px #ff9a9e;
    }

    .timeline-item:nth-child(3) .timeline-card {
        border-left-color: #f6d365;
        background: linear-gradient(135deg, #f6d365, #fda085);
        color: #fff;
    }

    .timeline-item:nth-child(3) .timeline-node {
        background: #f6d365;
        box-shadow: 0 0 15px #f6d365;
    }

    .timeline-item:nth-child(4) .timeline-card {
        border-left-color: #84fab0;
        background: linear-gradient(135deg, #84fab0, #8fd3f4);
        color: #fff;
    }

    .timeline-item:nth-child(4) .timeline-node {
        background: #84fab0;
        box-shadow: 0 0 15px #84fab0;
    }

    .timeline-item:nth-child(5) .timeline-card {
        border-left-color: #a18cd1;
        background: linear-gradient(135deg, #a18cd1, #fbc2eb);
        color: #fff;
    }

    .timeline-item:nth-child(5) .timeline-node {
        background: #a18cd1;
        box-shadow: 0 0 15px #a18cd1;
    }

</style>


<div class="row">
    <div class="col-md-12">
        <div class="card" style="margin-top:15px">
            <div class="card-content collapse show">
                <div class="card-body">

                    <div class="form-body">
                        <h4 class="form-section">
                            <i class="ft-flag"></i> Complain History
                        </h4>
                        <hr>
                        <br>

                        <div class="col-md-6">

                            <label for="Compl">Complain Number</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                            <select id="Compl" name="Compl" class="form-control" asp-items="ViewBag.Compl">
                                <option value="">-- Select --</option>
                            </select>
                            <span id="error-message-dep"></span>


                            <br>
                            <div class="form-actions">
                                <button type="button" class="btn btn-danger mr-1" onclick="ViewHistory()">Show Details</button>
                            </div>

                        </div>


                        @* ===================================================================== *@


                        <div class="container py-5">
                            <div class="timeline" id="timelineList">
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/tables/jquery.datatables.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/modal/components-modal.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/js/font-awesome-all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweet-alerts.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/select2/js/select2.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/bootstrap/js/bootstrap.bundle.min.js"></script>


<script>

    $('#timelineList').hide();
    function ViewHistory() {
        var ComplainNo = document.getElementById("Compl").value;
        $('#timelineList').show();
        $.ajax({
            url: '@Url.Action("GetComplaintHistoryDetails", "ComplaintManageProcess")',
            type: "GET",
            data: { id: ComplainNo },
            dataType: 'json',
            success: function (data) {

                var Compleathtml = ``;
                var Bodyhtml = ``;
                var html = ``;
                var forloopNo = 0;
                $.each(data, function (index, item) {
                    forloopNo++;
                    var titleText = (item.matrixOrder == 1) ? "Complaint Registered": "Complaint Assigned";
                    var lastItem = data[data.length - 1];
                    Bodyhtml += `
                            <div class="timeline-item">
                                 <div class="timeline-node"></div>
                                    <div class="timeline-card">
                                            <h6 class="mb-1">Complaint Assigned</h6>
                                            <p class="mb-0 small"><strong>Complaint Department : </strong> ${item.departmentName}</p>
                                            <p class="mb-0 small col-md-2"><strong>Forward User : </strong> ${item.forwordUser}</p>

                                </div>
                              </div>
                        `;

                    if(forloopNo == 1){
                        var formattedDate = item.createdDate.replace("T", "  ");

                        html += `
                            <div class="timeline-item">
                                 <div class="timeline-node"></div>
                                    <div class="timeline-card">
                                            <h6 class="mb-1">${titleText}</h6>
                                            <p class="mb-0 small"><strong>Created User Name : </strong> ${item.forwordUser}</p>
                                            <p class="mb-0 small"><strong>User Department   : </strong> ${item.dep}</p>
                                    <div class="small opacity-75 mt-1">${formattedDate}</div>
                                </div>
                              </div>
                        `;

                         // ----------------------------------------------------------------------------------

                        var lastItem = data[data.length - 1];
                         if (lastItem.isResolved) {
                            var resolvedDate = lastItem.resolvedDateTime ? lastItem.resolvedDateTime.replace("T", "  ") : "";

                            Compleathtml += `
                                <div class="timeline-item">
                                 <div class="timeline-node"></div>
                                    <div class="timeline-card">
                                            <h6 class="mb-1">Complaint Resolved</h6>
                                            <p class="mb-0 small"><strong>Resolved By : </strong> ${item.resolvedUser}</p>
                                            <p class="mb-0 small"><strong>Remark : </strong> ${item.resolvedRemark}</p>
                                    <div class="small opacity-75 mt-1">${resolvedDate}</div>
                                </div>
                              </div>
                            `;
                        }
                    }


                });



                $("#timelineList").html(html + Bodyhtml + Compleathtml);
            },
            error: function (xhr, status, error) {
                console.error("Error:", xhr.responseText);
                alert("Error while loading history!");
            }
        });
    }





</script>