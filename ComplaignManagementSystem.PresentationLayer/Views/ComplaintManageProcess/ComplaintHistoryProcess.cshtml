<style>
    body {
        background: linear-gradient(135deg, #e0f7fa, #fce4ec);
        font-family: 'Poppins', sans-serif;
    }

    .timeline {
        position: relative;
        padding: 3rem 0;
        margin: 0 auto;
    }

        /* Left-side vertical line */
        .timeline::before {
            content: "";
            position: absolute;
            left: 20px;
            top: 0;
            width: 6px;
            height: 100%;
            background: linear-gradient(180deg, #4facfe, #00f2fe);
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(0, 123, 255, 0.3);
        }

    .timeline-item {
        position: relative;
        width: 100%;
        padding-left: 60px;
        padding-bottom: 2rem;
    }

    .timeline-card {
        position: relative;
        background: #fff;
        border-radius: 15px;
        padding: 1rem 1.5rem;
        width: 50%;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
        border-left: 5px solid transparent;
    }

        .timeline-card:hover {
            transform: scale(1.03);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        }

    .timeline-node {
        position: absolute;
        top: 1.5rem;
        left: 10px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        z-index: 2;
        border: 4px solid #fff;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
    }

    

   
</style>


