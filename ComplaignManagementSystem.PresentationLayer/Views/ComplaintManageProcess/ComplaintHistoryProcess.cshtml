<script>

        function ViewHistory() {
        var ComplainNo = document.getElementById("Compl").value;

        $.ajax({
            url: '@Url.Action("GetComplaintHistoryDetails", "ComplaintManageProcess")',
            type: "GET",
            data: { id: ComplainNo },
            dataType: 'json',
            success: function (data) {
                
                var Compleathtml = ``;
                var Bodyhtml = ``;
                var html = ``;
                var forloopNo = 0;
                $.each(data, function (index, item) {  
                    forloopNo++;
                    var titleText = (item.matrixOrder == 1) ? "Complaint Registered": "Complaint Assigned";
                    var formattedDate = item.createdDate.replace("T", "  ");
                    var DepName = item.departmentName;
                    
                    if(item.isSentDep == 1){
                        console.log(DepName);
                        if(DepName != "Central"){                            
                            DepName = DepName + ' Department';
                        }

                    Bodyhtml += `
                            <div class="timeline-item">
                                 <div class="timeline-node"></div>
                                    <div class="timeline-card">
                                            <h5 class="mb-1">Complaint assigned to ${DepName} </h5>
                                            <p class="mb-0 small"><strong>Forwarder Name : </strong> ${item.forwordUser}</p>
                                            <p class="mb-0 small"><strong>Forwarder Remark : </strong> ${item.remark}</p>
                                     <div class="small opacity-75 mt-1">${formattedDate}</div>
                                </div>
                              </div>
                        `;
                        }

                    if(forloopNo == 1){                                                

                        html += `
                            <div class="timeline-item">
                                 <div class="timeline-node"></div>
                                    <div class="timeline-card">
                                            <h5 class="mb-1">${titleText}</h5>
                                            <p class="mb-0 small"><strong>User Name : </strong> ${item.forwordUser}</p>
                                            <p class="mb-0 small"><strong>Department : </strong> ${item.dep}</p>
                                    <div class="small opacity-75 mt-1">${formattedDate}</div>
                                </div>
                              </div>
                        `;

                         // ----------------------------------------------------------------------------------

                        var lastItem = data[data.length - 1];                    
                         if (lastItem.isResolved) {
                            var resolvedDate = lastItem.resolvedDateTime ? lastItem.resolvedDateTime.replace("T", "  ") : "";                        

                            Compleathtml += `
                                <div class="timeline-item">
                                 <div class="timeline-node"></div>
                                    <div class="timeline-card">
                                            <h5 class="mb-1">Complaint Resolved</h5>
                                            <p class="mb-0 small"><strong>Resolved By : </strong> ${item.resolvedUser}</p>
                                            <p class="mb-0 small"><strong>Remark : </strong> ${item.resolvedRemark}</p>
                                    <div class="small opacity-75 mt-1">${resolvedDate}</div>
                                </div>
                              </div>
                            `;
                        }
                    }


                });


                                                           
                $("#timelineList").html(html + Bodyhtml + Compleathtml);
                ApplyTimelineColors();
            },
            error: function (xhr, status, error) {
                console.error("Error:", xhr.responseText);
                alert("Error while loading history!");
            }
        });
    }




        function ApplyTimelineColors() {

        const palette = [
            { from: "#36d1dc", to: "#5b86e5", node: "#36d1dc" },
            { from: "#ff9a9e", to: "#fad0c4", node: "#ff9a9e" },
            { from: "#f6d365", to: "#fda085", node: "#f6d365" },
            { from: "#84fab0", to: "#8fd3f4", node: "#84fab0" },
            { from: "#a18cd1", to: "#fbc2eb", node: "#a18cd1" }
        ];

        const items = document.querySelectorAll(".timeline-item");

        items.forEach((item, idx) => {
            const set = palette[idx % palette.length];
            const card = item.querySelector(".timeline-card");
            const node = item.querySelector(".timeline-node");

            if (card) {
                card.style.background = `linear-gradient(135deg, ${set.from}, ${set.to})`;
                card.style.borderLeftColor = set.from;
                card.style.color = "#fff";
            }
            if (node) {
                node.style.background = set.node;
                node.style.boxShadow = `0 0 15px ${set.node}`;
            }
        });
    }





</script>