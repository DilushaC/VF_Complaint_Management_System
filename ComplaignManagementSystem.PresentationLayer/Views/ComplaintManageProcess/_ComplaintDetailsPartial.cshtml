@using ComplaignManagementSystem.Data.Models
@model ComplaignManagementSystem.Data.Models.ComplaintMaster // Change this to your actual model namespace

<hr />
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-3">
                <strong>Refference</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.Refference)
            </div>
        </div>
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Complaint Method</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.Method)
            </div>
        </div>
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Complaint Branch</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.ComBranch)
            </div>
        </div>
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Complaint Department</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.Department)
            </div>
        </div>

        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Complaint</strong>
            </div>
            <div class="col-md-8">
                :  @Html.DisplayFor(m => m.Complaint)
            </div>
        </div>
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Acttachment</strong>
            </div>
            <div class="col-md-3">
                : @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                                {
                    <a href="@Url.Action("DownloadAttachment", "ComplaintManageProcess", new { fileName = Model.AttachmentPath })" target="_blank" style="margin-top:10px">
                        <i class="fa-regular fa-file-pdf" style="height:25px; width:25px"></i>
                    </a>
                }
                                else
                {
                    <span>No attachment</span>
                }
            </div>
        </div>
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Created Branch</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.Branch)
            </div>
        </div>
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Created User Name</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.CreatedUser)
            </div>
        </div>
        <hr />
        <h4>Customer Details</h4>
        <br />
        @if (!string.IsNullOrEmpty(Model.Cus_Name))
        {
            <div class="row" style="margin-top:7px">
                <div class="col-md-3">
                    <strong>Customer Name</strong>
                </div>
                <div class="col-md-6">
                    :  @Html.DisplayFor(m => m.Cus_Name)
                </div>
            </div>
        }
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Customer NIC</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.Cus_Nic)
            </div>
        </div>
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Customer Mobile</strong>
            </div>
            <div class="col-md-6">
                :  @Html.DisplayFor(m => m.Cus_MobileNumber)
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Cus_Refference))
        {
            <div class="row" style="margin-top:7px">
                <div class="col-md-3">
                    <strong>Customer Refference</strong>
                </div>
                <div class="col-md-3">
                    :  @Html.DisplayFor(m => m.Cus_Refference)
                </div>
            </div>
        }
    </div>
</div>

@if (ViewBag.SendDepDetailListCount != 0)
{
    string lastDep;
    var list = ViewBag.SendDepDetailList as List<SendDepartmentModel>;
    int i = 1;
    @foreach (var item in ViewBag.SendDepDetailList)
    {
        if (item.EscalatiomMatrix > 1)
        {
            <hr />
            int LastMatrix = item.EscalatiomMatrix - 1;
            string LastDepartment = list?.Where(a => a.EscalatiomMatrix == LastMatrix).Select(a => a.DepartmentName).FirstOrDefault();

            <h3>@i.ToString("00")) Forward from @LastDepartment to @item.DepartmentName</h3>
            <div class="row" style="margin-top:15px">
                <div class="col-md-3">
                    <strong>Frowarder Remark</strong>
                </div>
                <div class="col-md-8">
                    :  @item.Remark
                </div>
            </div>
            <div class="row" style="margin-top:7px">
                <div class="col-md-3">
                    <strong>Frowarder User</strong>
                </div>
                <div class="col-md-8">
                    :  @item.ForwardUser
                </div>
            </div>
            <div class="row" style="margin-top:7px">
                <div class="col-md-3">
                    <strong>Froward Date</strong>
                </div>
                <div class="col-md-8">
                    :  @item.CreatedDate.ToString("dd/mm/yyyy")
                </div>
            </div>
            i++;
        }
    }
}

@if (ViewBag.PendingDetailListCount != 0)
{
    int i = 1;
    <hr />
    <h4>Pending Comment Details</h4>
    @foreach (var item in ViewBag.PendingDetailList)
    {
        <div class="row" style="margin-top:15px">
            <div class="col-md-3">
                <strong>@i.ToString("00")) Pending Remark</strong>
            </div>
            <div class="col-md-8">
                :  @item.Remark
            </div>
        </div>
        i++;
    }
}

@if (Model.Status == "Resolved")
{
    <hr />
    <h4>Resolved Details</h4>
    <br />
    <div class="row" style="margin-top:7px">
        <div class="col-md-3">
            <strong>Resolved User</strong>
        </div>
        <div class="col-md-6">
            :  @Html.DisplayFor(m => m.ResolvedUser)
        </div>
    </div>
    <div class="row" style="margin-top:7px">
        <div class="col-md-3">
            <strong>Resolved Date</strong>
        </div>
        <div class="col-md-6">
            :  @Html.DisplayFor(m => m.ResolvedDateTime)
        </div>
    </div>
    <div class="row" style="margin-top:7px">
        <div class="col-md-3">
            <strong>Remark</strong>
        </div>
        <div class="col-md-6">
            :  @Html.DisplayFor(m => m.ResolvedRemark)
        </div>
    </div>
    if (Model.IsCentralComment == false)
    {
        <hr />
        <div class="row" style="margin-top:17px">
            <div class="col-md-12">
                <strong>Comment :</strong><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                <textarea id="CentralComment" class="form-control" placeholder="Remark." name="CentralComment" rows="6" cols="100" style="margin-top:10px"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn grey btn-success" onclick="AddCentralComment('@Model.Id')">Save</button>
        </div>
        <hr />
    }
    else
    {
        <hr />
        <div class="row" style="margin-top:7px">
            <div class="col-md-3">
                <strong>Central Comment</strong>
            </div>
            <div class="col-md-8">
                :  @Html.DisplayFor(m => m.CentralComment)
            </div>
        </div>
        <hr />
    }



}

@if (Context.Session.GetString("UserPermission") == "Central User" || Context.Session.GetString("UserPermission") == "Admin ")
{
    @if (Model.Status != "Resolved")
    {
        <hr />
        <div class="row" style="margin-top:17px">
            <div class="col-md-12">
                <strong>Pending Remark :</strong><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                <textarea id="PendingRemark" class="form-control" placeholder="Remark." name="PendingRemark" rows="6" cols="100" style="margin-top:10px"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn grey btn-success" onclick="AddPeningComment('@Model.Id')">Save</button>
        </div>
    }
}

<hr />
<br />
<div class="modal-footer">
    <button type="button" class="btn grey btn-secondary" data-bs-dismiss="modal">Close</button>
</div>

<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/sweet alert/sweetalert2.all.min.js"></script>
<script>
    function AddCentralComment(complaintId) {
        //alert();
        var remark = document.getElementById("CentralComment").value;
        if (remark.trim() === "") {
            Swal.fire({
                title: 'Warning!',
                text: 'Comment is a required field. Please enter a remark.',
                icon: 'warning',
                confirmButtonText: 'OK'
            });
        }else{
            $.ajax({
                url: '@Url.Action("CentralCommentUpdate", "ComplaintManageProcess")',
                type: 'POST',
                data: { id: complaintId, CentralComment:remark },
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'Success!',
                            text: 'Successfully Saved Complaint.',
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = '@Url.Action("CentralProcess", "ComplaintManageProcess")';
                        });
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: response.message || 'Complain Resolve Failed.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        title: 'Error!',
                        text: 'Error Complain Resolve.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            });
        }
    }
    function AddPeningComment(complaintId) {
        //alert();
        var remark = document.getElementById("PendingRemark").value;
        if (remark.trim() === "") {
            Swal.fire({
                title: 'Warning!',
                text: 'Comment is a required field. Please enter a remark.',
                icon: 'warning',
                confirmButtonText: 'OK'
            });
        }else{
            $.ajax({
                url: '@Url.Action("CentralPeningCommentUpdate", "ComplaintManageProcess")',
                type: 'POST',
                data: { id: complaintId, CentralPendingComment:remark },
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            title: 'Success!',
                            text: 'Successfully Saved Complaint.',
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = '@Url.Action("CentralProcess", "ComplaintManageProcess")';
                        });
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: response.message || 'Complain Resolve Failed.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        title: 'Error!',
                        text: 'Error Complain Resolve.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            });
        }
    }
</script>

