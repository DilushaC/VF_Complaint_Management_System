@using ComplaignManagementSystem.Data.Models
@model List<Complaint_ManageProcessModel>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Reference</th>
                <th>Date Complaint Made</th>
                <th>Complaint Received Via</th>
                <th>Customer Reference No</th>
                <th>Branch</th>
                <th>Department</th>
                <th>Customer Name</th>
                <th>Complaint in breif</th>
                <th>Abbreviation letters for complaint</th>
                <th>Resolution</th>
                <th>Resposible Officer</th>
                <th>Date Resolved</th>
                <th>Resolution Communicated Via</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.Refference</td>
                        <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.ComplaintMethod</td>
                        <td>@item.Cus_Refference</td>
                        <td>@item.ComBranch</td>
                        <td>@item.Dep</td>
                        <td>@item.Cus_Name</td>
                        <td>@item.Complaint</td>
                        <td>@item.ResolvedRemark</td>
                        <td>@item.NatureCode</td>
                        <td>@item.OfficerName</td>
                        <td>@item.ResolvedDateTime.Value.ToString("yyyy-MM-dd")</td>
                        <td>@item.CusNotification</td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="13" class="text-center">No data found</td>
                </tr>
            }
        </tbody>
    </table>
</div>