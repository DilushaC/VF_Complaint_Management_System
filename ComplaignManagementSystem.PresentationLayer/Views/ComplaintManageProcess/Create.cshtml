                        <div class="form-body">
                            <h4 class="form-section">
                                <i class="ft-flag"></i> Complain Create Form
                            </h4>
                            <div class="form-group">
                                <label for="Complaint Method">Complaint Method</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <select id="ComplaintMethod_Id" name="ComplaintMethod_Id" class="form-control" asp-items="ViewBag.ComplaintMethod_Id">
                                    <option value="">-- Select --</option>
                                </select>
                                <span id="error-message-method"></span>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Cus_Name">Customer Name</label>
                                        <input type="text" id="Cus_Name" class="form-control" placeholder="Customer Name" name="Cus_Name" autocomplete="off">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Cus_Nic">Customer NIC</label>
                                        <input type="text" id="Cus_Nic" class="form-control" placeholder="Customer NIC" name="Cus_Nic" autocomplete="off" onkeyup="nicChange()" maxlength="12">
                                        <small id="nicError" style="color:red; display:none;">Invalid NIC</small>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Refference">Refference</label>
                                        <input type="text" id="Cus_Refference" class="form-control" placeholder="Facility / Ticket No / FD Number / etc..." name="Cus_Refference" autocomplete="off">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Cus_MobileNumber">Customer Mobile Number</label>
                                        <input type="text" id="Cus_MobileNumber" class="form-control" placeholder="Customer Mobile Number" name="Cus_MobileNumber" autocomplete="off" onkeyup="mobileChange()" maxlength="10">
                                        <small id="mobileError" style="color:red; display:none;">Invalid Mobile Number</small>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="col-md-3 label-control">Select File</label>
                                    <label id="Attachment" class="file center-block">
                                        <input type="file" id="file" name="file" style="margin:15px">
                                        <span class="file-custom"></span>
                                        <span id="error-message-attachement"></span>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label for="Dep_Id">Department</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                    <select id="Dep_Id" name="Dep_Id" class="form-control" asp-items="ViewBag.Dep_Id">
