@model ComplaignManagementSystem.Data.Context.DapperContext

@{
    ViewData["Title"] = "Create Form";
    ViewData["MenuTab"] = "ComplaintMenu";
    ViewData["SubMenuTab"] = "CreateFormScreen";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/css/plugins/forms/checkboxes-radios.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/icheck.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/custom.css" rel="stylesheet" />

<div class="row">
    <div class="col-md-12">
        <div class="card" style="margin-top:15px">
            <div class="card-content collapse show">
                <div class="card-body">
                    @using (Html.BeginForm("SubmitComplain", "ComplaintManageProcess", FormMethod.Post, new { enctype = "multipart/form-data", id = "complainForm" }))
                    {
                        <div class="form-body">
                            <h4 class="form-section">
                                <i class="ft-flag"></i> Complain Create Form
                            </h4>
                            <div class="form-group">
                                <label for="Complaint Method">Complaint Method</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <select id="ComplaintMethod_Id" name="ComplaintMethod_Id" class="form-control" asp-items="ViewBag.ComplaintMethod_Id">
                                    <option value="">-- Select --</option>
                                </select>
                                <span id="error-message-method"></span>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Cus_Name">Customer Name</label>
                                        <input type="text" id="Cus_Name" class="form-control" placeholder="Customer Name" name="Cus_Name" autocomplete="off">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Cus_Nic">Customer NIC</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <input type="text" id="Cus_Nic" class="form-control" placeholder="Customer NIC" name="Cus_Nic" autocomplete="off" onkeyup="nicChange()" maxlength="12">
                                        <small id="nicError" style="color:red; display:none;">Invalid NIC</small>
                                        <span id="error-message-NIC"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Refference">Refference</label>
                                        <input type="text" id="Cus_Refference" class="form-control" placeholder="Facility / Ticket No / FD Number / etc..." name="Cus_Refference" autocomplete="off">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Cus_MobileNumber">Customer Mobile Number</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                        <input type="text" id="Cus_MobileNumber" class="form-control" placeholder="Customer Mobile Number" name="Cus_MobileNumber" autocomplete="off" onkeyup="mobileChange()" maxlength="10">
                                        <small id="mobileError" style="color:red; display:none;">Invalid Mobile Number</small>
                                        <span id="error-message-Mobile"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="OfficerEPF">Officer EPF</label>
                                        <input type="text" id="OfficerEPF" class="form-control" placeholder="Officer EPF Number..." name="OfficerEPF" autocomplete="off">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="OfficerName">Officer Name</label>
                                        <input type="text" id="OfficerName" class="form-control" placeholder="Officer Name" name="OfficerName" autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <label class="col-md-3 label-control">Select File</label>
                                    <label id="Attachment" class="file center-block">
                                        <input type="file" id="file" name="file" style="margin:15px">
                                        <span class="file-custom"></span>
                                        <span id="error-message-attachement"></span>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label for="Branch_Id">Complaint Branch</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                    <select id="Branch_Id" name="Branch_Id" class="form-control" asp-items="ViewBag.Branch_Id">
                                        <option value="">-- Select --</option>
                                    </select>
                                    <span id="error-message-branch"></span>
                                </div>
                            </div>
                            <div class="row" style="margin-top:20px">
                                <div class="col-md-6">
                                    <label for="Dep_Id">Complaint Department</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                    <select id="Dep_Id" name="Dep_Id" class="form-control" asp-items="ViewBag.Dep_Id">
                                        <option value="">-- Select --</option>
                                    </select>
                                    <span id="error-message-dep"></span>
                                </div>
                                <div class="col-md-6">
                                    <label for="Nature_Id">Nature of Complaint</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                    <select id="Nature_Id" name="Nature_Id" class="form-control">
                                        <option value="">-- Select --</option>
                                    </select>
                                    <span id="error-message-nature"></span>
                                </div>
                                </div>
                            <div class="row" style="margin-top:20px">

                                <div class="col-md-6" style="position: relative;">
                                    <label for="Priority">Priority</label>
                                    <div class="row" style="margin-left:5px">
                                        <div class="custom-control custom-checkbox col-md-2.5">
                                            <input type="checkbox" class="custom-control-input" id="PriorityL" name="Priority" value="Low" onclick="handlePriority(this)" checked>
                                            <label class="custom-control-label" for="PriorityL">Low</label>
                                        </div>
                                        <div class="custom-control custom-checkbox col-md-2.5" style="margin-left:25px">
                                            <input type="checkbox" class="custom-control-input" id="PriorityM" name="Priority" value="Medium" onclick="handlePriority(this)">
                                            <label class="custom-control-label" for="PriorityM">Medium</label>
                                        </div>
                                        <div class="custom-control custom-checkbox col-md-2.5" style="margin-left:25px">
                                            <input type="checkbox" class="custom-control-input" id="PriorityH" name="Priority" value="High" onclick="handlePriority(this)">
                                            <label class="custom-control-label" for="PriorityH">High</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group" style="margin-top:10px">
                                <label for="Complaint">Complaint</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <textarea id="Complaint" rows="5" class="form-control" name="Complaint" placeholder="About Complaint"></textarea>
                                <span id="error-message-complaint"></span>
                            </div>
                        </div>

                        <div class="form-group" style="margin-top:10px">
                            <h3> If you resolved this Complaint?</h3>
                            <br />
                            <div class="row" style="margin-left:10px">
                                <div class="col-md-2 custom-control">
                                    <label for="ResolvedStatus-Yes">Yes</label>
                                    <input class="form-control" type="radio" id="ResolvedStatus-Yes" name="ResolvedStatus" value="Yes" style="block-size:20px;margin:-28px;margin-left:0px">
                                </div>
                                <div class="col-md-2 custom-control" style="margin-left:-40px">
                                    <label for="ResolvedStatus-No">No</label>
                                    <input class="form-control" type="radio" id="ResolvedStatus-No" name="ResolvedStatus" value="No" style="block-size:20px;margin:-28px" checked>
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row" style="margin-top:7px" id="revolveT">
                            <hr />
                            <div class="col-md-12">
                                <strong>Remark :</strong><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <textarea id="Remarktxt" class="form-control" placeholder="Remark." name="ResolvedRemark" rows="6" cols="100" style="margin-top:10px"></textarea>
                                <span id="error-message-remark"></span>
                            </div>
                        </div>
                        <br />
                        <div class="form-actions">
                            <button type="button" class="btn btn-danger mr-1">
                                Clear
                            </button>
                            <button type="button" class="btn btn-success" id="save">
                                Save
                            </button>
                            <button type="button" class="btn btn-info" id="savensend">
                                Save and send
                            </button>
                            <button type="button" class="btn btn-primary" id="savenresolved">
                                Save and Resolved
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/tables/jquery.datatables.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/modal/components-modal.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/js/font-awesome-all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweet-alerts.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/sweet alert/sweetalert2.all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/select2/js/select2.min.js"></script>


<script>
    $('#savenresolved').hide();
    $('#revolveT').hide();
    $("#ComplaintMethod_Id").select2({
      allowClear:true,
      placeholder: 'Select Method'
    });
    $("#Branch_Id").select2({
      allowClear:true,
      placeholder: 'Select Complaint Branch'
    });
    $("#Dep_Id").select2({
      allowClear:true,
      placeholder: 'Select Complaint Department'
    });
    $("#Nature_Id").select2({
      allowClear:true,
      placeholder: 'Select Nature'
    });
    function nicChange(){               
        const nic = document.getElementById("Cus_Nic").value;   
        //alert(Compaint);   
        const oldNicPattern = /^[0-9]{9}[VXvx]$/;  // Old format    
        const newNicPattern = /^[0-9]{12}$/;      // New format
        const save = document.getElementById("save");
        const savensend = document.getElementById("savensend");
        const savenresolved = document.getElementById("savenresolved");
                
        const errorMessageNICContainer = document.getElementById('error-message-NIC');         
        errorMessageNICContainer.textContent = '';

        if (nic === "") {    
            document.getElementById("Cus_Nic").style.borderColor = "";    
            return;    
        }    
        if (oldNicPattern.test(nic) || newNicPattern.test(nic)) {    
            // Valid NIC    
            document.getElementById("Cus_Nic").style.borderColor = "green";
            document.getElementById("nicError").style.display = "none";
            save.disabled = false;
            savensend.disabled = false;
            savenresolved.disabled = false;
        } else {    
            // Invalid NIC    
            document.getElementById("Cus_Nic").style.borderColor = "red";  
            document.getElementById("nicError").style.display = "inline";
            save.disabled = true;
            savensend.disabled = true;
            savenresolved.disabled = true;
        }
    }
        
    function mobileChange() {
        const mobile = document.getElementById("Cus_MobileNumber").value.trim();
        const mobilePattern = /^07[0-9]{8}$/; // 10 digits starting with 07                
        const errorMessageMobileContainer = document.getElementById('error-message-Mobile');         
        errorMessageMobileContainer.textContent = '';

        if (mobilePattern.test(mobile)) {
            document.getElementById("Cus_MobileNumber").style.borderColor = "green";
            document.getElementById("mobileError").style.display = "none";                        
            save.disabled = false;
            savensend.disabled = false;
            savenresolved.disabled = false;
        } else {
            document.getElementById("Cus_MobileNumber").style.borderColor = "red";
            document.getElementById("mobileError").style.display = "inline";                        
            save.disabled = true;
            savensend.disabled = true;
            savenresolved.disabled = true;
        }
    }
    function handlePriority(checkbox) {
        const clickedCheckboxId = checkbox.id;
        if(checkbox.id == "PriorityL"){
            document.getElementById("PriorityM").checked = false;
            document.getElementById("PriorityH").checked = false;
        }else if(checkbox.id == "PriorityM"){
            document.getElementById("PriorityL").checked = false;
            document.getElementById("PriorityH").checked = false;
        }else if(checkbox.id == "PriorityH"){
            document.getElementById("PriorityM").checked = false;
            document.getElementById("PriorityL").checked = false;
        }else{
            document.getElementById("PriorityL").checked = false;
            document.getElementById("PriorityM").checked = false;
            document.getElementById("PriorityH").checked = false;
        }
    }
    $('#Dep_Id').on('change', function () {
        let selectedDepId = $(this).val();
        let selectedText = $(this).find('option:selected').text();
        // Perform further actions based on the new selection
        $('#Nature_Id').empty().append('<option value="">-- Select --</option>');
        if (selectedDepId) {
            $.ajax({
                url: '@Url.Action("GetNaturesByDepartment", "ComplaintManageProcess")',
                type: 'GET',
                data: { depId: selectedDepId },
                dataType: 'json',
                success: function (data) {
                    $.each(data, function (i, item) {
                        $('#Nature_Id').append($('<option>', {
                            value: item.id,
                            text: item.nature
                        }));
                    });
                },
                error: function (error) {
                    console.log("Error fetching data: ", error);
                }
            });
        }
    });
    $('#Nature_Id').on('change', function () {
        let selectedText = $(this).find('option:selected').text();
        // Perform further actions based on the new selection                    
        const textBox = document.getElementById("Complaint");            
        // Set the new value           
        textBox.value = selectedText;
    });
    document.addEventListener('DOMContentLoaded', function () {
        const fileInput = document.getElementById('file');
        const errorMessageContainer = document.getElementById('error-message-attachement');
        const allowedExtension = '.pdf';
        const button = document.getElementById("savensend");
        fileInput.addEventListener('change', function () {
            errorMessageContainer.textContent = '';
            if (fileInput.files.length > 0) {
                const selectedFile = fileInput.files[0];
                const fileName = selectedFile.name;
                const fileExtension = fileName.substring(fileName.lastIndexOf('.')).toLowerCase();

                if (fileExtension !== allowedExtension) {
                    errorMessageContainer.textContent = 'Only PDF files are allowed.';
                    errorMessageContainer.style.color = 'red';
                    fileInput.value = '';
                    button.disabled = true;
                }else{
                     button.disabled = false;
                }
            }
        });
    });
    $('input[name="ResolvedStatus"]').on('change', function () {
      var selectedValue = $(this).val();
      onStatusChange(selectedValue);
    });
    function onStatusChange(value) {
      // alert("Selected status: " + value);
      if(value == "Yes"){
          $('#revolveT').show();              
          $('#savenresolved').show();
          $('#savensend').hide();
      }else{
          $('#revolveT').hide();
          $('#savenresolved').hide();
          $('#savensend').show();
      }
    }

    $('#save').on('click', function () {
        var form = $('#complainForm');    
        const button = document.getElementById("savensend");  

        // Change action dynamically
        form.attr('action', '/ComplaintManageProcess/SaveComplaint');
        form.submit();
    });


    $('#savensend').on('click', function () {
        var form = $('#complainForm');
        const button = document.getElementById("savensend");
        const errorMessageMthodContainer = document.getElementById('error-message-method');
        const errorMessageDepContainer = document.getElementById('error-message-dep');
        const errorMessageNatureContainer = document.getElementById('error-message-nature');
        const errorMessageComplaintContainer = document.getElementById('error-message-complaint');
        const errorMessageNICContainer = document.getElementById('error-message-NIC');
        const errorMessageMobileContainer = document.getElementById('error-message-Mobile');
        const errorMessageBranchContainer = document.getElementById('error-message-branch');
            
        var Method = document.getElementById("ComplaintMethod_Id").value;            
        var Branch_Id = document.getElementById("Branch_Id").value;
        var Dep = document.getElementById("Dep_Id").value;
        var Nature = document.getElementById("Nature_Id").value;
        var Compaint = document.getElementById("Complaint").value;
        var Cus_Nic = document.getElementById("Cus_Nic").value;
        var Cus_MobileNumber = document.getElementById("Cus_MobileNumber").value;
            
        let isValid = true;

        if (Method == "") {
            errorMessageMthodContainer.textContent = 'Please Select the Method.';
            errorMessageMthodContainer.style.color = 'red';              
            isValid = false;
        }
        if (Branch_Id == "") {
            errorMessageBranchContainer.textContent = 'Please Select the Complaint Branch.';
            errorMessageBranchContainer.style.color = 'red';
            isValid = false;
        }
        if (Dep == "") {
            errorMessageDepContainer.textContent = 'Please Select the Complaint Department.';
            errorMessageDepContainer.style.color = 'red';
            isValid = false;
        }
        if (Nature == "") {
            errorMessageNatureContainer.textContent = 'Please Select the Nature.';
            errorMessageNatureContainer.style.color = 'red';
            isValid = false;
        }
        if (Compaint == "") {
            errorMessageComplaintContainer.textContent = 'Please enter the Complaint.';
            errorMessageComplaintContainer.style.color = 'red';
            isValid = false;
        }
        if (Cus_Nic == "") {
            errorMessageNICContainer.textContent = 'Please enter the Customer NIC.';
            errorMessageNICContainer.style.color = 'red';
            isValid = false;
        }
                
        if (Cus_MobileNumber == "") {
            errorMessageMobileContainer.textContent = 'Please Enter the Customer Mobile Number.';
            errorMessageMobileContainer.style.color = 'red';
            isValid = false;
        }
                
        if (!isValid) {
            event.preventDefault();
            return false;
        }else{        
            // Change action dynamically        
            Swal.fire({        
                title: 'Are you sure?',        
                text: "Do you want to Send this Complaint?",        
                icon: 'question',        
                showCancelButton: true,        
                confirmButtonColor: '#28a745',        
                cancelButtonColor: '#d33',        
                confirmButtonText: 'Yes, Send it!'        
            }).then((result) => {        
                if (result.isConfirmed) {        
                    Swal.fire({        
                        title: 'Success!',        
                        text: 'Successfully Sent Complain.',        
                        icon: 'success',        
                        timer: 2000,        
                        showConfirmButton: false        
                    }).then(() => {        
                        form.attr('action', '/ComplaintManageProcess/SubmitAndSendComplain');        
                        form.submit();        
                    })        
                }        
            })
        }
    });
    $('#savenresolved').on('click', function () {
        var form = $('#complainForm');
       const errorMessageMthodContainer = document.getElementById('error-message-method');
        const errorMessageDepContainer = document.getElementById('error-message-dep');
        const errorMessageNatureContainer = document.getElementById('error-message-nature');
        const errorMessageComplaintContainer = document.getElementById('error-message-complaint');
        const errorMessageNICContainer = document.getElementById('error-message-NIC');
        const errorMessageMobileContainer = document.getElementById('error-message-Mobile');

        var Method = document.getElementById("ComplaintMethod_Id").value;
        var Dep = document.getElementById("Dep_Id").value;
        var Nature = document.getElementById("Nature_Id").value;
        var Compaint = document.getElementById("Complaint").value;
        var Cus_Nic = document.getElementById("Cus_Nic").value;
        var Cus_MobileNumber = document.getElementById("Cus_MobileNumber").value;

        let isValid = true;

        if (Method == "") {
            errorMessageMthodContainer.textContent = 'Please Select the Method.';
            errorMessageMthodContainer.style.color = 'red';
            isValid = false;
        }
        if (Dep == "") {
            errorMessageDepContainer.textContent = 'Please Select the Department.';
            errorMessageDepContainer.style.color = 'red';
            isValid = false;
        }
        if (Nature == "") {
            errorMessageNatureContainer.textContent = 'Please Select the Nature.';
            errorMessageNatureContainer.style.color = 'red';
            isValid = false;
        }
        if (Compaint == "") {
            errorMessageComplaintContainer.textContent = 'Please enter the Complaint.';
            errorMessageComplaintContainer.style.color = 'red';
            isValid = false;
        }
        if (Cus_Nic == "") {
            errorMessageNICContainer.textContent = 'Please enter the Customer NIC.';
            errorMessageNICContainer.style.color = 'red';
            isValid = false;
        }

        if (Cus_MobileNumber == "") {
            errorMessageMobileContainer.textContent = 'Please Enter the Customer Mobile Number.';
            errorMessageMobileContainer.style.color = 'red';
            isValid = false;
        }

        if (!isValid) {
            event.preventDefault();
            return false;
        }else{        
            // Change action dynamically        
            Swal.fire({        
                title: 'Are you sure?',        
                text: "Do you want to Resolved this Complaint?",        
                icon: 'question',        
                showCancelButton: true,        
                confirmButtonColor: '#3085d6',        
                cancelButtonColor: '#d33',        
                confirmButtonText: 'Yes, Resolved it!'        
            }).then((result) => {             
                if (result.isConfirmed) {                  
                    Swal.fire({            
                        title: 'Success!',             
                        text: 'Successfully Complain Resolved.',                     
                        icon: 'success',             
                        timer: 2000,              
                        showConfirmButton: false             
                    }).then(() => {           
                        form.attr('action', '/ComplaintManageProcess/SubmitAndSendComplain');                                              
                        form.submit();              
                    }) 
                } 
            })
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
