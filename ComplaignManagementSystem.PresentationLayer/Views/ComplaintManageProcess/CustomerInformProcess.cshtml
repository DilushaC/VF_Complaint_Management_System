@using ComplaignManagementSystem.Data.Models

@{
    ViewData["Title"] = "Customer Inform";
    ViewData["MenuTab"] = "CustomerInformProcessMenu";
    ViewData["SubMenuTab"] = "CustomerInformProcessMenu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/tables/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/extensions/toastr.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/css/fontawesome-all.min.css" rel="stylesheet" />

<link href="~/plugins/demo/chameleon-admin-template/app-assets/css/plugins/forms/checkboxes-radios.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/icheck.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/custom.css" rel="stylesheet" />

<div class="row">
    <div class="col-md-12">
        <div class="card" style="margin-top:15px">
            <div class="card-content collapse show">
                <div class="card-body">
                    <div class="form-body">
                        <h4 class="form-section">
                            <i class="ft-flag"></i> Customer Inform
                        </h4>
                        <hr>
                        <br>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="ComplaintId">Complain Number</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <select id="ComplaintId" name="ComplaintId" class="form-control" asp-items="ViewBag.ComplaintId">
                                    <option value="">-- Select --</option>
                                </select>
                                <span id="error-message-dep"></span>
                            </div>
                        </div>
                        <div class="row" style="margin-top:1%" id="radioDiv">
                            <div class="col-md-6" style="margin-top:10px">
                                <div class="form-group" style="margin-top:10px">
                                    <h5>Customer notified about the resolution?</h5>
                                    <br />
                                    <div class="row" style="margin-left:10px">
                                        <div class="col-md-3">
                                            <label for="CusNotified-Yes">Yes</label>
                                            <input class="form-control" type="radio" id="CusNotified-Yes" name="CusNotified" value="Yes" style="block-size:20px;margin:-28px;margin-left:0px">
                                        </div>
                                        <div class="col-md-4" style="margin-left:-40px">
                                            <label for="CusNotified-No">No</label>
                                            <input class="form-control" type="radio" id="CusNotified-No" name="CusNotified" value="No" style="block-size:20px;margin:-28px" checked>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr style="margin-top:20px" id="otherHR" />
                        <div class="row" style="margin-top:2%" id="otherDiv">
                            <div class="col-md-6">
                                <label for="notification">Customer informed status</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <select id="notification" name="notification" class="form-control" asp-items="ViewBag.notification" style="width:100%">
                                    <option value="">-- Select --</option>
                                </select>
                                <span id="error-message-Status"></span>
                            </div>
                            <div class="col-md-6" style="margin-top:-1px">
                                <div class="col-md-6">
                                    <label class="col-md-6">Attachment</label>
                                    <label id="Attachment" class="file center-block">
                                        <input type="file" id="CustomerFile" name="file" style="margin:15px">
                                        <span class="file-custom"></span>
                                        <span id="error-message-attachement"></span>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group" style="margin-top:10px">
                                    <label for="Complaint">Remark</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                    <textarea id="Complaint" rows="5" class="form-control" name="Complaint" placeholder="Remark"></textarea>
                                    <span id="error-message-complaint"></span>
                                </div>
                            </div>
                            <br />
                        </div>
                        <hr style="margin-top:20px" />
                        <div class="col-md-6" style="margin-top:2%" id="btnDiv">
                            <div class="form-actions">
                                <button type="button" class="btn btn-bg-gradient-x-orange-yellow col-12 col-md-5 mr-1 mb-1" id="svbtn" onclick="CustomerInform()">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="card" style="margin-top:15px">
            <div class="card-body">
                @Html.Partial("_CutomerNotifiedDetails")
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/tables/jquery.datatables.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/modal/components-modal.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/js/font-awesome-all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweet-alerts.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/sweet alert/sweetalert2.all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/select2/js/select2.min.js"></script>

<script>
    $("#ComplaintId").select2({
      allowClear:true,
      placeholder: 'Select Complaint'
    });
    $("#notification").select2({
      allowClear:true,
      placeholder: 'Select Type'
    });

    $('#ComplaintId').on('change', function () {
        let selectedDepId = $(this).val();
        // Perform further actions based on the new selection
        if (selectedDepId) {
            $('#radioDiv').show();
            $('#btnDiv').show();
        }else{
            $('#radioDiv').hide();
            $('#btnDiv').hide();
            $('#otherDiv').hide();
            $('#otherHR').hide();
        }
    });
    $('#radioDiv').hide();
    $('#otherDiv').hide();
    $('#otherHR').hide();
    $('#btnDiv').hide();
    $('input[name="CusNotified"]').on('change', function () {
      var selectedValue = $(this).val();
      onStatusChange(selectedValue);
    });
    function onStatusChange(value) {
        // alert("Selected status: " + value);
        if(value == "Yes"){
            $('#radioDiv').show();
            $('#otherDiv').show();
            $('#btnDiv').show();
            $('#otherHR').show();
        }else{
            $('#radioDiv').show();
            $('#btnDiv').show();
            $('#otherDiv').hide();
            $('#otherHR').hide();
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const fileInput = document.getElementById('CustomerFile');
        const errorMessageContainer = document.getElementById('error-message-attachement');
        const allowedExtension = '.pdf';
        const button = document.getElementById("svbtn");
        fileInput.addEventListener('change', function () {
            errorMessageContainer.textContent = '';
            if (fileInput.files.length > 0) {
                const selectedFile = fileInput.files[0];
                const fileName = selectedFile.name;
                const fileExtension = fileName.substring(fileName.lastIndexOf('.')).toLowerCase();

                if (fileExtension !== allowedExtension) {
                    errorMessageContainer.textContent = 'Only PDF files are allowed.';
                    errorMessageContainer.style.color = 'red';
                    fileInput.value = '';
                    button.disabled = true;
                }else{
                     button.disabled = false;
                }
            }
        });
    });
    function CustomerInform() {
        var formData = new FormData();
        let isValid = true;

        const CusNotified = $('input[name="CusNotified"]:checked').val();
        const notification = document.getElementById("notification");
        const Complaint = document.getElementById("Complaint");
        const errorStatus = document.getElementById('error-message-Status');
        const errorcomplaint = document.getElementById('error-message-complaint');
        //alert(CusNotified.value.trim());
        if(CusNotified == "Yes"){
            if (notification.value.trim() === "") {
                errorStatus.textContent = 'Please Select the Status.';
                errorStatus.style.color = 'red';
                isValid = false;
            }
            if (notification.value.trim() === "") {
                errorcomplaint.textContent = 'Please Enter the Complaint.';
                errorcomplaint.style.color = 'red';
                isValid = false;
            }
        }

        if (!isValid) {
            event.preventDefault();
            return false;
        }else{
            formData.append("ComplainNo", $("#ComplaintId").val());
            formData.append("NotifiID", $("#notification").val());
            formData.append("Complaint", $("#Complaint").val());
            var status = $('input[name="CusNotified"]:checked').val();
            formData.append("isNotified", status === "Yes");
            var fileInput = document.getElementById("CustomerFile");
            if (fileInput.files.length > 0) {
                formData.append("file", fileInput.files[0]);
            }
            $.ajax({
                url: '@Url.Action("UpdateCustomerInformDetails", "ComplaintManageProcess")',
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (data) {
                    Swal.fire({
                        title: 'Success!',
                        text: 'Successfully informed the customer.',
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        $('#Compl').val('');
                        $('#notifi').val('');
                        $('#Complaint').val('');
                        $('#yourFileInputId').val('');
                        $('#ResolvedStatus-Yes').prop('checked', true);
                        window.location.href = '@Url.Action("CustomerInformProcess", "ComplaintManageProcess")';
                    })
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                }
            });
        }
    }
    $(document).ready(function() {
        var ToastMessage = '@(TempData.ContainsKey("ToastMessage") ? TempData["ToastMessage"] as string : "")';
        if (ToastMessage) {
            var toastEl = document.getElementById('toastId');
            if (toastEl) {
                var toastTitle = toastEl.querySelector('.toast-title');
                var toastMsg = toastEl.querySelector('.toast-message');
                if(ToastMessage == 'SubmittedSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Saved Customer Notification";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-success");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
            } else {
                console.error("Toast container element not found.");
            }
        }
    });
</script>

