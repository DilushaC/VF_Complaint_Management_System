@using ComplaignManagementSystem.Data.Models
@* @model IEnumerable<ComplaignManagementSystem.Data.Context.DapperContext> *@

@{
    ViewData["Title"] = "Customer Inform";
    ViewData["MenuTab"] = "CustomerInformProcessMenu";
    ViewData["SubMenuTab"] = "CustomerInformProcessMenu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/tables/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/extensions/toastr.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/css/fontawesome-all.min.css" rel="stylesheet" />

<link href="~/plugins/demo/chameleon-admin-template/app-assets/css/plugins/forms/checkboxes-radios.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/icheck.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/forms/icheck/custom.css" rel="stylesheet" />




<div class="row">
    <div class="col-md-12">
        <div class="card" style="margin-top:15px">
            <div class="card-content collapse show">
                <div class="card-body">

                    <div class="form-body">
                        <h4 class="form-section">
                            <i class="ft-flag"></i> Customer Inform
                        </h4>
                        <hr>
                        <br>

                        <div class="col-md-12 row">

                            <div class="col-md-6">
                            <label for="Compl">Complain Number</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                            <select id="Compl" name="Compl" class="form-control" asp-items="ViewBag.Compl">
                                <option value="">-- Select --</option>
                            </select>
                            <span id="error-message-dep"></span>
                            </div>


                            <div class="col-md-6">
                                <label for="notifi">Customer informed status</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <select id="notifi" name="notifi" class="form-control" asp-items="ViewBag.notifi">
                                    <option value="">-- Select --</option>
                                </select>
                                <span id="error-message-dep"></span>
                            </div>


                            <div class="col-md-6" style="margin-top:10px">
                            <label for="">Attachment</label>
                            <fieldset class="form-group">
                                <div class="custom-file">
                                        <input type="file" class="custom-file-input" id="CustomerFile">
                                        <label class="custom-file-label" for="CustomerFile">Choose file</label>
                                </div>
                            </fieldset>
                            </div>


                            <div class="col-md-6" style="margin-top:10px">
                                <div class="form-group" style="margin-top:10px">
                                    <h5>Customer notified about the resolution?</h5>
                                    <br />
                                    <div class="row" style="margin-left:10px">

                                        <div class="col-md-3">
                                            <label for="ResolvedStatus-Yes">Yes</label>
                                            <input class="form-control" type="radio" id="ResolvedStatus-Yes" name="ResolvedStatus" value="Yes" checked style="block-size:20px;margin:-28px;margin-left:0px">
                                        </div>
                                        <div class="col-md-4" style="margin-left:-40px">
                                            <label for="ResolvedStatus-No">No</label>
                                            <input class="form-control" type="radio" id="ResolvedStatus-No" name="ResolvedStatus" value="No" style="block-size:20px;margin:-28px">
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="col-md-12">
                            <div class="form-group" style="margin-top:10px">
                                <label for="Complaint">Other</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <textarea id="Complaint" rows="5" class="form-control" name="Complaint" placeholder="Other"></textarea>
                                <span id="error-message-complaint"></span>
                                </div>
                            </div>

                           

                            <br/>


                            <div class="col-md-6">
                            <div class="form-actions">
                                    <button type="button" class="btn btn-danger mr-1" onclick="CustomerInform()">Save and Close</button>
                                </div>
                            </div>

                        </div>


                        @* ===================================================================== *@


                        <div class="container py-5">

                            <div class="timeline" id="timelineList">
                             

                            </div>
                        </div>


                    </div>



                </div>
            </div>
        </div>
    </div>

</div>



<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/tables/jquery.datatables.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/modal/components-modal.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/js/font-awesome-all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweet-alerts.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/select2/js/select2.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/bootstrap/js/bootstrap.bundle.min.js"></script>

<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweetalert2@11.min.js"></script>




<script>
        
    function CustomerInform() {     
        
        var formData = new FormData();       
        formData.append("ComplainNo", $("#Compl").val());
        formData.append("NotifiID", $("#notifi").val());
        formData.append("Complaint", $("#Complaint").val());

        var status = $('input[name="ResolvedStatus"]:checked').val();
        formData.append("isNotified", status === "Yes");
        
        var fileInput = document.getElementById("CustomerFile");
        if (fileInput.files.length > 0) {
            formData.append("file", fileInput.files[0]);
        }
                
        $.ajax({        
            url: '@Url.Action("UpdateCustomerInformDetails", "ComplaintManageProcess")',       
            type: "POST",       
            data: formData,       
            contentType: false,          
            processData: false,          
            success: function (data) {                             
                Swal.fire({       
                    title: 'Success!',
                    text: 'Successfully informed the customer.',
                    icon: 'success',       
                    timer: 2000,       
                    showConfirmButton: false       
                }).then(() => {                

                   $('#Compl').val('');
                   $('#notifi').val('');
                   $('#Complaint').val('');
                   $('#yourFileInputId').val('');
                   $('#ResolvedStatus-Yes').prop('checked', true);

                   window.location.href = '@Url.Action("CustomerInformProcess", "ComplaintManageProcess")';

                })       
            },       
            error: function (xhr) {       
                console.log(xhr.responseText);       
            }    
        });    
}

                      
 </script>

