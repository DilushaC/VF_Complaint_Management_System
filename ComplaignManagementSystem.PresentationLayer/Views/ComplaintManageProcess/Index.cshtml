@using ComplaignManagementSystem.Data.Models
@* @model IEnumerable<ComplaignManagementSystem.Data.Context.DapperContext> *@

@{
    ViewData["Title"] = "Complaint Master";
    ViewData["MenuTab"] = "ComplaintMenu";
    ViewData["SubMenuTab"] = "ComplaintMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var successMessage = TempData["SuccessMessage"] as string;
    var complaintList = ViewBag.ComplainLists as List<Complaint_ManageProcessModel>;
    var searchString = Context.Request.Query["searchString"].ToString();
    var totalCount = (int)ViewBag.TotalCount;
    var pageSize = (int)ViewBag.PageSize;
    var pageNumber = (int)ViewBag.PageNumber;
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
}
<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/tables/datatable/datatables.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/extensions/toastr.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/css/fontawesome-all.min.css" rel="stylesheet" />
<style>
    .modal {
        z-index: 1060 !important; /* higher than sidebar */
    }

    .modal-backdrop {
        z-index: 1055 !important;
    }
</style>
<div class="card" style="margin-top:20px">
    <div class="row">
        <div class="col-md-12">
            <div class="card-header">
                <h1>Complaint Master</h1>
                <hr />
            </div>
            <div class="card-content collapse show">
                <div class="card-body card-dashboard">
                    <div class="table-responsive">
                        <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4" style="margin-top:-10px">
                            <div class="row">
                                <div class="col-sm-12 col-md-3" style="margin-left:-30px;margin-bottom:-30px">
                                    <form id="searchForm" asp-controller="ComplaintManageProcess" asp-action="Index" method="get">
                                        <div id="DataTables_Table_0_filter" class="dataTables_filter">
                                            <label>
                                                Search:
                                                <input type="search" id="searchInput" name="searchString" value="@Context.Request.Query["searchString"]" class="form-control form-control-sm" placeholder="" aria-controls="DataTables_Table_0">
                                            </label>
                                            <input type="hidden" name="pageSize" value="@pageSize" />
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <div style="text-align:right; margin-right:5px;margin-bottom:0px">
                                <button type="button" class="btn btn-bg-gradient-x-purple-blue col-md-3 mr-1 mb-1" onclick="goToCreate()"> Create New Complaint</button>
                            </div>
                            <div class="row">
                                <div class="col-sm-12 col-md-3">
                                    <form id="pageSizeForm" asp-controller="ComplaintManageProcess" asp-action="Index" method="get">
                                        <div class="dataTables_length" id="DataTables_Table_0_length">
                                            <label>
                                                Show
                                                <select name="pageSize" aria-controls="DataTables_Table_0" class="form-control form-control-sm" onchange="this.form.submit()">
                                                    <option value="10" selected="@(pageSize == 10)">10</option>
                                                    <option value="25" selected="@(pageSize == 25)">25</option>
                                                    <option value="50" selected="@(pageSize == 50)">50</option>
                                                    <option value="100" selected="@(pageSize == 100)">100</option>
                                                </select> entries
                                            </label>
                                        </div>
                                    </form>
                                </div>

                                <div class="col-sm-12 col-md-6" style="margin-left:-10px">
                                    <form id="filterForm" asp-controller="ComplaintManageProcess" asp-action="Index" method="get">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <select id="ComplaintMethod_Id" name="ComplaintMethod_Id" class="form-control" asp-items="ViewBag.ComplaintMethod_Id">
                                                    <option value="">Methods...</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4" style="margin-left:150px">
                                                <select id="priorityFilter" name="priority" class="form-control form-control-sm">
                                                    <option value="">Priorities...</option>
                                                    @if (ViewBag.Priority == "High")
                                                    {
                                                        <option value="High" selected>High</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="High">High</option>
                                                    }
                                                    @if (ViewBag.Priority == "Medium")
                                                    {
                                                        <option value="Medium" selected>Medium</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Medium">Medium</option>
                                                    }
                                                    @if (ViewBag.Priority == "Low")
                                                    {
                                                        <option value="Low" selected>Low</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Low">Low</option>
                                                    }

                                                </select>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <table class="table table-striped table-bordered base-style dataTable" id="DataTables_Table_0" role="grid" aria-describedby="DataTables_Table_0_info">
                                        <thead>
                                            <tr role="row">
                                                <th class="sorting_asc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="0" colspan="0" aria-sort="ascending" aria-label="Name: activate to sort column descending" style="width: 126.391px;">#</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Position: activate to sort column ascending" style="width: 196.859px;">Refference</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Office: activate to sort column ascending" style="width: 91.6406px;">Complaint Method</th>
                                                @* <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Age: activate to sort column ascending" style="width: 28.7969px;">Complaint</th> *@
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Start date: activate to sort column ascending" style="width: 76.1094px;">Created Branch</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Salary: activate to sort column ascending" style="width: 120.6094px;">Priotity</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Salary: activate to sort column ascending" style="width: 120.6094px;">Created Date</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Salary: activate to sort column ascending" style="width: 150px;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (ViewBag.ComplainLists != null && ViewBag.ComplainLists.Count > 0)
                                            {
                                                int i = 1;
                                                @foreach (var item in ViewBag.ComplainLists)
                                                {
                                                    <tr role="row" class="odd">
                                                        <td class="sorting_1">@i</td>
                                                        <td>@item.Refference</td>
                                                        <td>@item.Method</td>
                                                        @* <td>@item.Complaint</td> *@
                                                        <td>@item.Branch</td>
                                                        <td>@item.Priority</td>
                                                        <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                                        <td style="width:50px">
                                                            <div class="row">
                                                                <div class="col-md-2">
                                                                    <button type="button" class="btn btn-outline-purple" onclick="ComplaintDetils(@item.Id)" style="width:30px;height:30px"><i class="ft-eye"></i></button>
                                                                </div>
                                                                @if (item.Status == "Created")
                                                                {
                                                                    <div class="col-md-2" style="margin-left:30px;margin-right:20px">
                                                                        <button type="button" class="btn btn-outline-warning" onclick="ComplaintEdit(@item.Id)" style="width:30px;height:30px"><i class="ft-edit"></i></button>
                                                                    </div>
                                                                }
                                                            </div>

                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            }
                                            else
                                            {
                                                <tr role="row" class="odd">
                                                    <td colspan="6" class="text-center">No complaints found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th rowspan="1" colspan="1">#</th>
                                                <th rowspan="1" colspan="1">Refference</th>
                                                <th rowspan="1" colspan="1">Complaint Method</th>
                                                @* <th rowspan="1" colspan="1">Complaint</th> *@
                                                <th rowspan="1" colspan="1">Created Branch</th>
                                                <th rowspan="1" colspan="1">Priotity</th>
                                                <th rowspan="1" colspan="1">Created Date</th>
                                                <th rowspan="1" colspan="1">Action</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-12 col-md-5">
                                    <div class="dataTables_info" id="DataTables_Table_0_info" role="status" aria-live="polite">
                                        Showing 1 to @totalPages of @totalCount entries
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-7">
                                    <div class="dataTables_paginate paging_simple_numbers" id="DataTables_Table_0_paginate">
                                        <ul class="pagination">
                                            <li class="paginate_button page-item previous @(pageNumber <= 1 ? "disabled" : "")">
                                                <a href="@Url.Action("Index", new { pageNumber = pageNumber - 1, pageSize = pageSize })"
                                                   aria-controls="DataTables_Table_0" tabindex="0" class="page-link">Previous</a>
                                            </li>
                                            @for (int i = 1; i <= totalPages; i++)
                                            {
                                                <li class="paginate_button page-item @(i == pageNumber ? "active" : "")">
                                                    <a href="@Url.Action("Index", new { pageNumber = i, pageSize = pageSize })"
                                                       aria-controls="DataTables_Table_0" tabindex="0" class="page-link">@i</a>
                                                </li>
                                            }
                                            <li class="paginate_button page-item next @(pageNumber >= totalPages ? "disabled" : "")" id="DataTables_Table_0_next">
                                                <a href="@Url.Action("Index", new { pageNumber = pageNumber + 1, pageSize = pageSize })"
                                                   aria-controls="DataTables_Table_0" tabindex="0" class="page-link">Next</a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="modal fade" id="complaintModal" tabindex="-1" role="dialog" aria-labelledby="complaintModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="complaintModalLabel">Complaint Details</h2>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
                @* <partial name="_ComplaintDetailsPartial" /> *@
                @* @Html.Partial("_ComplaintDetailsPartial")  *@
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editComplaintModal" tabindex="-1" role="dialog" aria-labelledby="editComplaintModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title" id="editComplaintModalLabel">Complaint Edit Details</h1>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body" id="editComplaintContent">
            </div>
        </div>
    </div>
</div>


<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/tables/jquery.datatables.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/modal/components-modal.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/js/font-awesome-all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweet-alerts.min.js"></script>

<script src="~/plugins/demo/chameleon-admin-template/app-assets/select2/js/select2.min.js"></script>
<script src="~/js/feather.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/forms/toggle/switchery.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/forms/switch.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/core/app.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/core/app-menu.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/customizer.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/jquery.sharrre.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/forms/checkbox-radio.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/sweet alert/sweetalert2.all.min.js"></script>

<script type="text/javascript">
    function goToCreate() {
        window.location.href = '/ComplaintManageProcess/Create';
    }
    function ComplaintDetils(Id) {
        $.ajax({
            url: '@Url.Action("ComplaintDetails", "ComplaintManageProcess")',
            type: "GET",
            data: { id: Id },
            dataType: 'html',
            success: function (result) {
                $("#complaintModal .modal-body").html(result);
                $("#complaintModal").modal('show');
            },
            error: function (xhr, status, error) {
                console.error("Failed to load modal content:", error);
                alert("Error");
                // Optionally show an error message in the modal
                $("#complaintModal .modal-body").html("<p class='text-danger'>Error loading details.</p>");
                $("#complaintModal").modal('show');
            }
        });
    }
    function ComplaintEdit(id) {
        $.ajax({
            url: '/ComplaintManageProcess/EditComplaint',
            type: 'GET',
            data: { id: id },
            dataType: 'html',
            success: function (html) {
                $('#editComplaintContent').html(html);
                $('#editComplaintModal').modal('show');
                //bindEditFormSubmit(); // Bind form submit after loading content
            },
            error: function () {
                alert('Could not load complaint data.');
            }
        });
    }


    $("#ComplaintMethod_Id").select2({
      allowClear:true,
      placeholder: 'Methods...'
    });
    $("#priorityFilter").select2({
      allowClear:true,
      placeholder: 'Priorities...'
    });

    $('#ComplaintMethod_Id').on('change', function () {
        const form = document.getElementById('filterForm');
        var ComplaintMethod_Id = document.getElementById("ComplaintMethod_Id").value;
        var priorityFilter = document.getElementById("priorityFilter").value;

        var url = `/ComplaintManageProcess/Index?ComplaintMethod_Id=${ComplaintMethod_Id}&priority=${priorityFilter}`;
        // Redirect to that URL (submit form automatically)
        window.location.href = url;
    });
    $('#priorityFilter').on('change', function () {
        const form = document.getElementById('filterForm');
        var ComplaintMethod_Id = document.getElementById("ComplaintMethod_Id").value;
        var priorityFilter = document.getElementById("priorityFilter").value;

        var url = `/ComplaintManageProcess/Index?ComplaintMethod_Id=${ComplaintMethod_Id}&priority=${priorityFilter}`;
        // Redirect to that URL (submit form automatically)
        window.location.href = url;
    });
    $(document).ready(function() {
        // Find the select element and attach a change event handler
        $('#DataTables_Table_0_length select').on('change', function() {
            // Submit the form that contains the select element
            $('#pageSizeForm').submit();
        });
        var searchTimeout;
        var searchInput = $('#searchInput');
        var searchForm = $('#searchForm');
        var pageSizeInput = searchForm.find('input[name="pageSize"]');
        // Set the page size from the URL on page load
        var currentSearchString = searchInput.val();
        var currentPageSize = '@Context.Request.Query["pageSize"]';
        if (currentPageSize) {
            pageSizeInput.val(currentPageSize);
        }
        // Function to submit the search form
        function submitSearch() {
            searchForm.submit();
        }
        // Listen for keyup events on the search input
        searchInput.on('keyup', function() {
            // Clear the previous timeout to reset the delay
            clearTimeout(searchTimeout);
            // Set a new timeout to submit the form after a delay
            searchTimeout = setTimeout(submitSearch, 500); // 500ms delay
        });

        var ToastMessage = '@(TempData.ContainsKey("ToastMessage") ? TempData["ToastMessage"] as string : "")';
        if (ToastMessage) {
            var toastEl = document.getElementById('toastId');
            if (toastEl) {
                var toastTitle = toastEl.querySelector('.toast-title');
                var toastMsg = toastEl.querySelector('.toast-message');
                if(ToastMessage == 'SubmittedSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Saved Complaint";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-success");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
                else if(ToastMessage == 'EditedSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Edited Complaint";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-warning");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
                else if(ToastMessage == 'sentDepSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Sent to Department";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-success");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
                else if(ToastMessage == 'resolvedSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Resolved";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-success");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
            } else {
                console.error("Toast container element not found.");
            }
        }
    });
</script>
