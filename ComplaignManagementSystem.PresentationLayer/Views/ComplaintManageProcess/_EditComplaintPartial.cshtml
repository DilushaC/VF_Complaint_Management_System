                                <label for="Complaint Method">Complaint Method</label><span class="text-uppercase text-danger" style="margin-left:5px">*</span>
                                <br />
                                <select id="ComplaintMethod_Ids" name="ComplaintMethod_Ids" class="form-control" asp-items="ViewBag.ComplaintMethod_Id" style="width:80%">
                                    <option value="">-- Select --</option>
                                </select>
                                <span id="error-message-method"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Cus_Name">Customer Name</label>
                                <input type="text" id="Cus_Name" class="form-control" placeholder="Customer Name" name="Cus_Name" value="@Model.Cus_Name" autocomplete="off">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Cus_Nic">Customer NIC</label>
                                <input type="text" id="Cus_Nic" class="form-control" placeholder="Customer NIC" name="Cus_Nic" value="@Model.Cus_Nic" autocomplete="off" onkeyup="nicChange()">
                                <small id="nicError" style="color:red; display:none;">Invalid NIC</small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Refference">Refference</label>
                                <input type="text" id="Cus_Refference" class="form-control" placeholder="Refference" name="Cus_Refference" value="@Model.Cus_Refference" autocomplete="off">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Cus_MobileNumber">Customer Mobile Number</label>
                                <input type="text" id="Cus_MobileNumber" class="form-control" placeholder="Customer Mobile Number" name="Cus_MobileNumber" autocomplete="off" value="@Model.Cus_MobileNumber" onkeyup="mobileChange()" maxlength="10">
                                <small id="mobileError" style="color:red; display:none;">Invalid Mobile Number</small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6" id="attachId">
                            <label class="col-md-3 label-control">Select File</label>
                            <label id="Attachment" class="file center-block">
                                <input type="file" id="file" name="file" style="margin:15px">
                                <span class="file-custom"></span>
                                <span id="error-message"></span>
                            </label>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                        {
                            <div class="col-md-6 attachmentblock" id="attachmentblock">
                                <label class="col-md-3 label-control">Acttachment</label>
                                <br />
                                <a href="@Url.Action("DownloadAttachment", "ComplaintManageProcess", new { fileName = Model.AttachmentPath })" target="_blank" style="margin-top:30px;margin-left:30px">
                                    <i class="fa-regular fa-file-pdf" style="height:45px; width:45px"></i>
                                </a>
                                <button type="button" style="margin-left:20px;" onclick="deleteAttachment('@Model.Id')">X</button>
