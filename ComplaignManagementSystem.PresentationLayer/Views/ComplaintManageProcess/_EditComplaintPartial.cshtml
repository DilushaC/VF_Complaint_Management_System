                    $.each(data, function (i, item) {
                        $('#Nature_Id').append($('<option>', {
                            value: item.id,
                            text: item.nature,
                            selected: item.id == selectedNatureId
                        }));
                    });
                },
                error: function (error) {
                    console.log("Error fetching data: ", error);
                }
            });
        }

        if(Priority == "High"){
            document.getElementById("PriorityH").checked = true;
        }else if(Priority == "Medium"){
            document.getElementById("PriorityM").checked = true;
        } else {
             document.getElementById("PriorityL").checked = true;
        }


        console.log("Selected value: " + selectedValue);
