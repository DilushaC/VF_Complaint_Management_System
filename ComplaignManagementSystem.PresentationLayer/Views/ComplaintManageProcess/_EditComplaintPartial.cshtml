@model ComplaignManagementSystem.Data.Models.Complaint_ManageProcessModel


<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
<hr />
<h3>Complaint Refference : @Model.Refference</h3>
<hr style="margin-right:35%; margin-left:5px"
<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("UpdateComplaint", "ComplaintManageProcess", FormMethod.Post, new { enctype = "multipart/form-data", id = "ComplaignEdit" }))
