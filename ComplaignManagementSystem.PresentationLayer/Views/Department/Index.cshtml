@using ComplaignManagementSystem.Data.Models
@* @model IEnumerable<ComplaignManagementSystem.Data.Context.DapperContext> *@

@{
    ViewData["Title"] = "Department Master";
    ViewData["MenuTab"] = "MasterMainMenu";
    ViewData["SecMenuTab"] = "DepartmentMenu";
    ViewData["SubMenuTab"] = "DepartmentSubMenu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/plugins/demo/chameleon-admin-template/datatables/css/datatables.bootstrap4.min.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/select2/css/select2.min.css" rel="stylesheet" />
@* <link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/tables/datatable/datatables.min.css" rel="stylesheet" /> *@
<link href="~/plugins/demo/chameleon-admin-template/app-assets/vendors/css/extensions/toastr.css" rel="stylesheet" />
<link href="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/css/fontawesome-all.min.css" rel="stylesheet" />
<style>
    .modal {
        z-index: 1060 !important; /* higher than sidebar */
    }

    .modal-backdrop {
        z-index: 1055 !important;
    }
</style>



<div class="card" style="margin-top:20px">
    <div class="row">
        <div class="col-md-12">
            <div class="card-header">
                <h1>Department Create Form</h1>
                <hr />
            </div>
            @Html.Partial("_CreatePartial")
        </div>
    </div>
</div>




<div class="card" style="margin-top:20px">
    <div class="row">
        <div class="col-md-12">
            <div class="card-header">
                <h1>Department Master</h1>
                <hr />
            </div>
            <div class="card-content collapse show">
                <div class="card-body card-dashboard">
                    <div class="table-responsive">
                        <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4" style="margin-top:-10px">
                            <div class="row" style="margin-top:10px">
                                <div class="col-sm-12">
                                    <table class="table table-striped table-bordered base-style dataTable" id="DataTables_Table_0" role="grid" aria-describedby="DataTables_Table_0_info">
                                        <thead>
                                            <tr role="row">
                                                <th class="sorting_asc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="0" colspan="0" aria-sort="ascending" aria-label="Name: activate to sort column descending" style="width: 126.391px;">#</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Position: activate to sort column ascending" style="width: 196.859px;">Name</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Office: activate to sort column ascending" style="width: 91.6406px;">Code</th>
                                                @* <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Age: activate to sort column ascending" style="width: 28.7969px;">Complaint</th> *@
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Start date: activate to sort column ascending" style="width: 76.1094px;">CreatedDate</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Salary: activate to sort column ascending" style="width: 120.6094px;">Status</th>
                                                <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="Salary: activate to sort column ascending" style="width: 220.6094px;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (ViewBag.DepartmentList != null && ViewBag.DepartmentList.Count > 0)
                                            {
                                                int i = 1;
                                                @foreach (var item in ViewBag.DepartmentList)
                                                {

                                                    <tr role="row" class="odd">
                                                        <td class="sorting_1">@i</td>
                                                        <td>@item.Name</td>
                                                        <td>@item.Code</td>

                                                        <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                                        <td>@item.Status</td>
                                                        <td style="width:50px">
                                                            <div class="row">
                                                                <div class="col-md-2">
                                                                    <button type="button" class="btn btn-outline-purple" data-toggle="tooltip" data-placement="top" title="View" onclick="DepartmentDetils(@item.Id)" style="width:30px;height:30px"><i class="ft-eye"></i></button>
                                                                </div>

                                                                <div class="col-md-2" style="margin-left:20px;margin-right:20px">
                                                                    <button type="button" class="btn btn-outline-warning" data-toggle="tooltip" data-placement="top" title="Edit" onclick="DepartmentEdit(@item.Id)" style="width:30px;height:30px"><i class="ft-edit"></i></button>
                                                                </div>
                                                                <div class="col-md-2" style="margin-left:0px;margin-right:20px">
                                                                    <button type="button" class="btn btn-outline-danger" data-toggle="tooltip" data-placement="top" title="Delete" onclick="DepartmentDelete(@item.Id)" style="width:30px;height:30px"><i class="ft-delete"></i></button>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    i++;

                                                }
                                            }
                                            else
                                            {
                                                <tr role="row" class="odd">
                                                    <td colspan="6" class="text-center">No complaints found.</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th rowspan="1" colspan="1">#</th>
                                                <th rowspan="1" colspan="1">Name</th>
                                                <th rowspan="1" colspan="1">Code</th>
                                                @* <th rowspan="1" colspan="1">Complaint</th> *@
                                                <th rowspan="1" colspan="1">Created Branch</th>
                                                <th rowspan="1" colspan="1">Status</th>
                                                <th rowspan="1" colspan="1">Action</th>

                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<div class="modal fade" id="DepDetailModal" tabindex="-1" role="dialog" aria-labelledby="departmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="DepDetailModalLabel">Department Details</h2>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editDepartmentModal" tabindex="-1" role="dialog" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title" id="editDepartmentModalLabel">Department Edit Details</h1>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">X</button>
            </div>
            <div class="modal-body" id="editDepartmentContent">
            </div>
        </div>
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/tables/jquery.datatables.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/vendors/js/extensions/toastr.min.js"></script>

<script src="~/plugins/demo/chameleon-admin-template/app-assets/fonts/fontawesome/js/font-awesome-all.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/js/scripts/extensions/sweet-alerts.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/select2/js/select2.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/datatables/js/datatables.bootstrap4.min.js"></script>
<script src="~/plugins/demo/chameleon-admin-template/app-assets/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
       
    $('#DataTables_Table_0').DataTable({
        "paging": true,
        "searching": true,
        "ordering": true,
        "info": true,
        "pageLength": 10,
        "lengthMenu": [10, 25, 50, 100],
        "columnDefs": [
            { "orderable": false, "targets": [5] }
        ]
    });
    function DepartmentDetils(Id) {
        $.ajax({
            url: '@Url.Action("DepartmentDetails", "Department")',
            type: "GET",
            data: { id: Id },
            dataType: 'html',
            success: function (result) {
                $("#DepDetailModal .modal-body").html(result);
                $("#DepDetailModal").modal('show');
            },
            error: function (xhr, status, error) {
                console.error("Failed to load modal content:", error);
                alert("Error");
                // Optionally show an error message in the modal
                $("#DepDetailModal .modal-body").html("<p class='text-danger'>Error loading details.</p>");
                $("#DepDetailModal").modal('show');
            }
        });
    }
    function DepartmentEdit(id) {
        $.ajax({
            url: '/Department/Edit',
            type: 'GET',
            data: { id: id },
            dataType: 'html',
            success: function (html) {
                $('#editDepartmentContent').html(html);
                $('#editDepartmentModal').modal('show');
                //bindEditFormSubmit(); // Bind form submit after loading content
            },
            error: function () {
                alert('Could not load complaint data.');
            }
        });
    }
    function DepartmentDelete(depId) {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to delete this Department?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Delete", "Department")',
                    type: 'POST',
                    data: { id: depId },
                    success: function (response) {
                        if (response.success) {                       
                            Swal.fire({                       
                                icon: 'success',                       
                                title: 'Deleted!',                       
                                text: 'Department has been deleted successfully.',                       
                                confirmButtonColor: '#3085d6'                       
                            }).then(() => {                       
                                location.reload(); // Refresh table after delete                       
                            });                            
                        }
                        else {                       
                            Swal.fire({                            
                                icon: 'error',                            
                                title: 'Error',                            
                                text: response.message || 'Unable to delete department.'                        
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error!',
                            text: 'An error occurred while deleting attachment.',
                            icon: 'error',
                            confirmButtonText: 'OK'
                        });
                    }
                });
            }
        });
    }
    $(document).ready(function() {        
        var ToastMessage = '@(TempData.ContainsKey("ToastMessage") ? TempData["ToastMessage"] as string : "")';
        if (ToastMessage) {
            var toastEl = document.getElementById('toastId');
            if (toastEl) {
                var toastTitle = toastEl.querySelector('.toast-title');
                var toastMsg = toastEl.querySelector('.toast-message');
                if(ToastMessage == 'SubmittedDepSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Saved Department";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-success");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
                else if(ToastMessage == 'UpdatedDepSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Updated Department";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-success");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
                else if(ToastMessage == 'DeletedDepSuccessfully!'){
                    if (toastMsg) {
                        toastMsg.textContent = "Successfully Deleted Department";
                        toastTitle.textContent = "Success";
                        toastEl.classList.remove("toast-success", "toast-error", "toast-warning", "toast-info");
                        // Add the type class
                        toastEl.classList.add("toast-error");
                        var toast = new bootstrap.Toast(toastEl.querySelector('.toast'));
                        var options = { delay: 3000 }; // 3 seconds
                        var toast = new bootstrap.Toast(toastEl, options);
                        toast.show();
                    } else {
                        console.error("Toast body element not found.");
                    }
                }
                
            } else {
                console.error("Toast container element not found.");
            }
        }
    });
</script>
